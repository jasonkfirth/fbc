#pragma once
#inclib "raylib"
#ifndef __FB_JS__
#if defined(__FB_WIN32__)
	#inclib "opengl32"
	#inclib "gdi32"
	#inclib "winmm"
#elseif defined(__FB_LINUX__)
	#inclib "GL"
	#inclib "X11"
	#inclib "pthread"
	#inclib "dl"
	#inclib "rt"
	#inclib "m"
#elseif defined(__FB_DARWIN__)
	#inclib "OpenGL"
	#inclib "Cocoa"
	#inclib "IOKit"
	#inclib "CoreVideo"
#endif
#endif
#include once "crt/stdarg.bi"
#include once "crt/stdlib.bi"

extern "C"

'' The audio device owns these opaque objects. Only pointers cross the API.
type rAudioBuffer as rAudioBuffer_
type rAudioProcessor as rAudioProcessor_

#define RAYLIB_VERSION_MAJOR 5
#define RAYLIB_VERSION_MINOR 5
#define RAYLIB_VERSION_PATCH 0
#define RAYLIB_VERSION "5.5"
#define PI 3.141592653589793
#define DEG2RAD (PI/180.0f)
#define RAD2DEG (180.0f/PI)
#define RL_MALLOC(sz) malloc(sz)
#define RL_CALLOC(n,sz) calloc(n,sz)
#define RL_REALLOC(ptr,sz) realloc(ptr,sz)
#define RL_FREE(ptr) free(ptr)
#define LIGHTGRAY type<Color>(200, 200, 200, 255)
#define GRAY type<Color>(130, 130, 130, 255)
#define DARKGRAY type<Color>(80, 80, 80, 255)
#define YELLOW type<Color>(253, 249, 0, 255)
#define GOLD type<Color>(255, 203, 0, 255)
#define ORANGE type<Color>(255, 161, 0, 255)
#define PINK type<Color>(255, 109, 194, 255)
#define RED type<Color>(230, 41, 55, 255)
#define MAROON type<Color>(190, 33, 55, 255)
#define GREEN type<Color>(0, 228, 48, 255)
#define LIME type<Color>(0, 158, 47, 255)
#define DARKGREEN type<Color>(0, 117, 44, 255)
#define SKYBLUE type<Color>(102, 191, 255, 255)
#define BLUE type<Color>(0, 121, 241, 255)
#define DARKBLUE type<Color>(0, 82, 172, 255)
#define PURPLE type<Color>(200, 122, 255, 255)
#define VIOLET type<Color>(135, 60, 190, 255)
#define DARKPURPLE type<Color>(112, 31, 126, 255)
#define BEIGE type<Color>(211, 176, 131, 255)
#define BROWN type<Color>(127, 106, 79, 255)
#define DARKBROWN type<Color>(76, 63, 47, 255)
#define WHITE type<Color>(255, 255, 255, 255)
#define BLACK type<Color>(0, 0, 0, 255)
#define BLANK type<Color>(0, 0, 0, 0)
#define MAGENTA type<Color>(255, 0, 255, 255)
#define RAYWHITE type<Color>(245, 245, 245, 255)
#define MOUSE_LEFT_BUTTON MOUSE_BUTTON_LEFT
#define MOUSE_RIGHT_BUTTON MOUSE_BUTTON_RIGHT
#define MOUSE_MIDDLE_BUTTON MOUSE_BUTTON_MIDDLE
#define MATERIAL_MAP_DIFFUSE MATERIAL_MAP_ALBEDO
#define MATERIAL_MAP_SPECULAR MATERIAL_MAP_METALNESS
#define SHADER_LOC_MAP_DIFFUSE SHADER_LOC_MAP_ALBEDO
#define SHADER_LOC_MAP_SPECULAR SHADER_LOC_MAP_METALNESS
#define GetMouseRay GetScreenToWorldRay

'' Vector2, 2 components
type Vector2
	x as single
	y as single
end type

'' Vector3, 3 components
type Vector3
	x as single
	y as single
	z as single
end type

'' Vector4, 4 components
type Vector4
	x as single
	y as single
	z as single
	w as single
end type

type Quaternion as Vector4

'' Matrix, 4x4 components, column major, OpenGL style, right-handed
type Matrix
	m0 as single
	m4 as single
	m8 as single
	m12 as single
	m1 as single
	m5 as single
	m9 as single
	m13 as single
	m2 as single
	m6 as single
	m10 as single
	m14 as single
	m3 as single
	m7 as single
	m11 as single
	m15 as single
end type

'' Color, 4 components, R8G8B8A8 (32bit)
type Color
	r as ubyte
	g as ubyte
	b as ubyte
	a as ubyte
end type

'' Rectangle, 4 components
type Rectangle
	x as single
	y as single
	width as single
	height as single
end type

'' Image, pixel data stored in CPU memory (RAM)
type Image
	data as any ptr
	width as long
	height as long
	mipmaps as long
	format as long
end type

'' Texture, tex data stored in GPU memory (VRAM)
type Texture
	id as ulong
	width as long
	height as long
	mipmaps as long
	format as long
end type

type Texture2D as Texture

type TextureCubemap as Texture

'' RenderTexture, fbo for texture rendering
type RenderTexture
	id as ulong
	texture as Texture
	depth as Texture
end type

type RenderTexture2D as RenderTexture

'' NPatchInfo, n-patch layout info
type NPatchInfo
	source as Rectangle
	left as long
	top as long
	right as long
	bottom as long
	layout as long
end type

'' GlyphInfo, font characters glyphs info
type GlyphInfo
	value as long
	offsetX as long
	offsetY as long
	advanceX as long
	image as Image
end type

'' Font, font texture and GlyphInfo array data
type Font
	baseSize as long
	glyphCount as long
	glyphPadding as long
	texture as Texture2D
	recs as Rectangle ptr
	glyphs as GlyphInfo ptr
end type

'' Camera, defines position/orientation in 3d space
type Camera3D
	position as Vector3
	target as Vector3
	up as Vector3
	fovy as single
	projection as long
end type

type Camera as Camera3D

'' Camera2D, defines position/orientation in 2d space
type Camera2D
	offset as Vector2
	target as Vector2
	rotation as single
	zoom as single
end type

'' Mesh, vertex data and vao/vbo
type Mesh
	vertexCount as long
	triangleCount as long
	vertices as single ptr
	texcoords as single ptr
	texcoords2 as single ptr
	normals as single ptr
	tangents as single ptr
	colors as ubyte ptr
	indices as ushort ptr
	animVertices as single ptr
	animNormals as single ptr
	boneIds as ubyte ptr
	boneWeights as single ptr
	boneMatrices as Matrix ptr
	boneCount as long
	vaoId as ulong
	vboId as ulong ptr
end type

'' Shader
type Shader
	id as ulong
	locs as long ptr
end type

'' MaterialMap
type MaterialMap
	texture as Texture2D
	color as Color
	value as single
end type

'' Material, includes shader and maps
type Material
	shader as Shader
	maps as MaterialMap ptr
	params(0 to 3) as single
end type

'' Transform, vertex transformation data
type Transform
	translation as Vector3
	rotation as Quaternion
	scale as Vector3
end type

'' Bone, skeletal animation bone
type BoneInfo
	name(0 to 31) as byte
	parent as long
end type

'' Model, meshes, materials and animation data
type Model
	transform as Matrix
	meshCount as long
	materialCount as long
	meshes as Mesh ptr
	materials as Material ptr
	meshMaterial as long ptr
	boneCount as long
	bones as BoneInfo ptr
	bindPose as Transform ptr
end type

'' ModelAnimation
type ModelAnimation
	boneCount as long
	frameCount as long
	bones as BoneInfo ptr
	framePoses as Transform ptr ptr
	name(0 to 31) as byte
end type

'' Ray, ray for raycasting
type Ray
	position as Vector3
	direction as Vector3
end type

'' RayCollision, ray hit information
type RayCollision
	hit as ubyte
	distance as single
	point as Vector3
	normal as Vector3
end type

'' BoundingBox
type BoundingBox
	min as Vector3
	max as Vector3
end type

'' Wave, audio wave data
type Wave
	frameCount as ulong
	sampleRate as ulong
	sampleSize as ulong
	channels as ulong
	data as any ptr
end type

'' AudioStream, custom audio stream
type AudioStream
	buffer as rAudioBuffer ptr
	processor as rAudioProcessor ptr
	sampleRate as ulong
	sampleSize as ulong
	channels as ulong
end type

'' Sound
type Sound
	stream as AudioStream
	frameCount as ulong
end type

'' Music, audio stream, anything longer than ~10 seconds should be streamed
type Music
	stream as AudioStream
	frameCount as ulong
	looping as ubyte
	ctxType as long
	ctxData as any ptr
end type

'' VrDeviceInfo, Head-Mounted-Display device parameters
type VrDeviceInfo
	hResolution as long
	vResolution as long
	hScreenSize as single
	vScreenSize as single
	eyeToScreenDistance as single
	lensSeparationDistance as single
	interpupillaryDistance as single
	lensDistortionValues(0 to 3) as single
	chromaAbCorrection(0 to 3) as single
end type

'' VrStereoConfig, VR stereo rendering configuration for simulator
type VrStereoConfig
	projection(0 to 1) as Matrix
	viewOffset(0 to 1) as Matrix
	leftLensCenter(0 to 1) as single
	rightLensCenter(0 to 1) as single
	leftScreenCenter(0 to 1) as single
	rightScreenCenter(0 to 1) as single
	scale(0 to 1) as single
	scaleIn(0 to 1) as single
end type

'' File path list
type FilePathList
	capacity as ulong
	count as ulong
	paths as zstring ptr ptr
end type

'' Automation event
type AutomationEvent
	frame as ulong
	type as ulong
	params(0 to 3) as long
end type

'' Automation event list
type AutomationEventList
	capacity as ulong
	count as ulong
	events as AutomationEvent ptr
end type

'' System/Window config flags
type ConfigFlags as long
enum
	FLAG_VSYNC_HINT = 64
	FLAG_FULLSCREEN_MODE = 2
	FLAG_WINDOW_RESIZABLE = 4
	FLAG_WINDOW_UNDECORATED = 8
	FLAG_WINDOW_HIDDEN = 128
	FLAG_WINDOW_MINIMIZED = 512
