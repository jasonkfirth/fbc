	FLAG_WINDOW_MOUSE_PASSTHROUGH = 16384
	FLAG_BORDERLESS_WINDOWED_MODE = 32768
	FLAG_MSAA_4X_HINT = 32
	FLAG_INTERLACED_HINT = 65536
end enum

'' Trace log level
type TraceLogLevel as long
enum
	LOG_ALL = 0
	LOG_TRACE = 1
	LOG_DEBUG = 2
	LOG_INFO = 3
	LOG_WARNING = 4
	LOG_ERROR = 5
	LOG_FATAL = 6
