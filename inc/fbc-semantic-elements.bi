'' Project: FreeBASIC semantic binary contract
'' File: fbc-semantic-elements.bi
'' Purpose: Name the binary tags and describe their semantic fields.
'' Responsibilities: Keep the producer and consumer record vocabulary identical.
'' Targets: Native FreeBASIC compiler and linter host builds; linted targets use
'' the compiler's target options.
'' Module API: Private helpers FbcSemElements() and FbcSemElementId().
'' This file intentionally does NOT contain:
''     - language parsing or semantic policy, which belong to the consumers.
'' Generated by build_scripts/update-semantic-binary-contract.py from the record table.
#ifndef FBC_SEMANTIC_ELEMENTS_BI
#define FBC_SEMANTIC_ELEMENTS_BI

private function FbcSemElements() as string
	dim as string result
	result += "record" + chr(9) + "1" + chr(9) + "FBCSEM" + chr(9) + "3" + chr(9) + "schema version, compiler version" + chr(10)
	result += "record" + chr(9) + "2" + chr(9) + "NT" + chr(9) + "11" + chr(9) + "subject domain, subject ID, role, primitive name, nominal symbol ID or zero, pointer depth, reference flag, const qualifier bits, storage bytes or empty, mangling modifier or empty" + chr(10)
	result += "record" + chr(9) + "3" + chr(9) + "PH" + chr(9) + "5" + chr(9) + "phase ID, procedure symbol ID, phase name, emitted flag" + chr(10)
	result += "record" + chr(9) + "4" + chr(9) + "NP" + chr(9) + "3" + chr(9) + "AST node ID, phase ID" + chr(10)
