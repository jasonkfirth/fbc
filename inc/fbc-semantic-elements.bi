	result += "record" + chr(9) + "32" + chr(9) + "O" + chr(9) + "10" + chr(9) + "operator code, operator kind, selected procedure ID, physical flag, source path, start line, start column, end line, end column" + chr(10)
	result += "record" + chr(9) + "33" + chr(9) + "Q" + chr(9) + "10" + chr(9) + "module source path, target ID, CPU ID, language, backend, pointer bytes, byte order, wchar bytes, default integer data type" + chr(10)
	result += "record" + chr(9) + "34" + chr(9) + "Y" + chr(9) + "7" + chr(9) + "data type, name, class, storage bytes, natural alignment, signed flag" + chr(10)
	result += "record" + chr(9) + "35" + chr(9) + "ASM" + chr(9) + "6" + chr(9) + "node ID, token ordinal, text/symbol kind, symbol ID or zero, byte-safe token text" + chr(10)
	result += "record" + chr(9) + "36" + chr(9) + "DCL" + chr(9) + "13" + chr(9) + "occurrence ID, symbol ID, declaration role, written name, physical flag, source path, start/end range, module ordinal, statement ordinal" + chr(10)
	result += "record" + chr(9) + "37" + chr(9) + "CTX" + chr(9) + "3" + chr(9) + "configuration identity, module ordinal" + chr(10)
	result += "record" + chr(9) + "38" + chr(9) + "OPT" + chr(9) + "5" + chr(9) + "configuration identity, option domain, option name, integer value" + chr(10)
	result += "record" + chr(9) + "39" + chr(9) + "USE" + chr(9) + "4" + chr(9) + "subject domain, subject identity, configuration identity" + chr(10)
	result += "record" + chr(9) + "40" + chr(9) + "FILE" + chr(9) + "7" + chr(9) + "revision ID, opened source path, byte count, SHA-256, encoding, regular/stream kind" + chr(10)
	result += "record" + chr(9) + "41" + chr(9) + "SRC" + chr(9) + "14" + chr(9) + "context ID, parent context ID, revision ID, module ordinal, context kind, include depth, requested path, physical flag, directive path, start/end range" + chr(10)
	result += "record" + chr(9) + "42" + chr(9) + "SRE" + chr(9) + "3" + chr(9) + "context ID, revision verification result" + chr(10)
	result += "record" + chr(9) + "43" + chr(9) + "INC" + chr(9) + "12" + chr(9) + "occurrence ID, parent context ID, requested path, resolved path, outcome, physical flag, directive path, start/end range" + chr(10)
	result += "record" + chr(9) + "44" + chr(9) + "MAP" + chr(9) + "11" + chr(9) + "context ID, logical line, logical path, physical flag, directive path, start/end range, remap occurrence ID" + chr(10)
	result += "record" + chr(9) + "45" + chr(9) + "ORIG" + chr(9) + "4" + chr(9) + "subject domain, subject identity, source context ID" + chr(10)
	result += "record" + chr(9) + "46" + chr(9) + "PPB" + chr(9) + "14" + chr(9) + "branch ID, parent branch ID, group ID, source context ID, configuration ID or zero, branch ordinal, directive kind, physical flag, directive path, start/end range" + chr(10)
	result += "record" + chr(9) + "47" + chr(9) + "PPD" + chr(9) + "11" + chr(9) + "branch ID, evaluation state, condition truth or empty, selected flag, physical flag, final token path, start/end range" + chr(10)
	result += "record" + chr(9) + "48" + chr(9) + "PPE" + chr(9) + "9" + chr(9) + "group ID, source context ID, physical flag, closing directive path, start/end range" + chr(10)
	result += "record" + chr(9) + "49" + chr(9) + "PPT" + chr(9) + "13" + chr(9) + "probe ID, branch ID or zero, source context ID, selected symbol ID or zero, first identifier spelling, found flag, physical flag, query path, start/end range" + chr(10)
	result += "record" + chr(9) + "50" + chr(9) + "PPS" + chr(9) + "10" + chr(9) + "inactive region ID, branch ID, source context ID, physical flag, source path, start/end range" + chr(10)
	result += "record" + chr(9) + "51" + chr(9) + "MD" + chr(9) + "10" + chr(9) + "definition ID, symbol ID or zero, module ordinal, configuration ID or zero, name, kind, formal count, flags, argless flag" + chr(10)
	result += "record" + chr(9) + "52" + chr(9) + "MT" + chr(9) + "6" + chr(9) + "definition ID, ordinal, token kind, value, paste-before flag" + chr(10)
	result += "record" + chr(9) + "53" + chr(9) + "MI" + chr(9) + "15" + chr(9) + "attempt ID, parent attempt ID, definition ID, source context ID, configuration ID or zero, conditional branch ID or zero, phase, parent relation, physical flag, name path, start/end range" + chr(10)
	result += "record" + chr(9) + "54" + chr(9) + "MA" + chr(9) + "12" + chr(9) + "attempt ID, formal ordinal, unit kind, argument text, has-source flag, physical flag, argument path, start/end range" + chr(10)
	result += "record" + chr(9) + "55" + chr(9) + "MS" + chr(9) + "8" + chr(9) + "attempt ID, piece ordinal, definition token ordinal or -1, formal ordinal or -1, piece kind, output offset, output length" + chr(10)
	result += "record" + chr(9) + "56" + chr(9) + "MC" + chr(9) + "5" + chr(9) + "attempt ID, unit kind, callback error code, actual callback return text" + chr(10)
	result += "record" + chr(9) + "57" + chr(9) + "ME" + chr(9) + "13" + chr(9) + "attempt ID, outcome, unit kind, output length, actual replacement text, actual argument count, physical flag, final input path, start/end range" + chr(10)
	result += "record" + chr(9) + "58" + chr(9) + "ML" + chr(9) + "13" + chr(9) + "occurrence ID, definition ID or zero, action, source context ID, configuration ID or zero, spelling, physical flag, declaration/undef path, start/end range" + chr(10)
	result += "record" + chr(9) + "59" + chr(9) + "MR" + chr(9) + "5" + chr(9) + "subject domain, subject ID, expansion attempt ID, observed role" + chr(10)
	result += "record" + chr(9) + "60" + chr(9) + "LOC" + chr(9) + "12" + chr(9) + "subject domain, subject ID, role, source context ID, physical start/end UTF-16 coordinates, start/end byte offsets, mapping state" + chr(10)
	result += "record" + chr(9) + "61" + chr(9) + "ST" + chr(9) + "17" + chr(9) + "statement ID, parent statement, compound ID, procedure owner, source context, configuration, module, source ordinal, token ID/class, physical flag, opening location" + chr(10)
	result += "record" + chr(9) + "62" + chr(9) + "STE" + chr(9) + "10" + chr(9) + "statement ID, parser route, outcome, physical flag, closing location" + chr(10)
	result += "record" + chr(9) + "63" + chr(9) + "BLK" + chr(9) + "14" + chr(9) + "compound ID, parent compound, opening statement, procedure owner, kind, source/configuration context, physical flag, opening location" + chr(10)
