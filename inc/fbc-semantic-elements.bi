	result += "record" + chr(9) + "6" + chr(9) + "CB" + chr(9) + "4" + chr(9) + "control-flow block ID, phase ID, ordinal" + chr(10)
	result += "record" + chr(9) + "7" + chr(9) + "CN" + chr(9) + "4" + chr(9) + "block ID, root AST node ID, ordinal" + chr(10)
