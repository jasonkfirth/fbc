	result += "record" + chr(9) + "10" + chr(9) + "DI" + chr(9) + "12" + chr(9) + "diagnostic ID, severity, compiler code, message, detail, custom text, path, line, source context ID or zero, statement ID or zero, procedure symbol ID or zero" + chr(10)
	result += "record" + chr(9) + "11" + chr(9) + "M" + chr(9) + "2" + chr(9) + "source path" + chr(10)
	result += "record" + chr(9) + "12" + chr(9) + "D" + chr(9) + "2" + chr(9) + "source path" + chr(10)
