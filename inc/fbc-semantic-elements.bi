	result += "record" + chr(9) + "26" + chr(9) + "G" + chr(9) + "9" + chr(9) + "procedure ID, parameter ID, source ordinal, passing mode, optional flag, array rank, body variable ID, instance flag" + chr(10)
	result += "record" + chr(9) + "27" + chr(9) + "U" + chr(9) + "12" + chr(9) + "symbol ID, kind, base type ID, alignment, unpadded length, options, ABI result type, abstract method count, enum element count, scope start line, scope end line" + chr(10)
	result += "record" + chr(9) + "28" + chr(9) + "C" + chr(9) + "5" + chr(9) + "identity domain, ID, value kind, encoded value" + chr(10)
	result += "record" + chr(9) + "29" + chr(9) + "H" + chr(9) + "7" + chr(9) + "source domain, source ID, target domain, target ID, relationship kind, ordinal" + chr(10)
	result += "record" + chr(9) + "30" + chr(9) + "K" + chr(9) + "5" + chr(9) + "identity domain, ID, property name, property value" + chr(10)
