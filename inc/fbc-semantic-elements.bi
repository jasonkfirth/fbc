	result += "record" + chr(9) + "71" + chr(9) + "Z" + chr(9) + "5" + chr(9) + "define symbol ID, ordinal, token kind, token value" + chr(10)
	return result
end function

private function FbcSemElementId(byref tag as const string) as integer
	select case tag
	case "FBCSEM": return 1
	case "NT": return 2
	case "PH": return 3
	case "NP": return 4
	case "EV": return 5
	case "CB": return 6
	case "CN": return 7
