	result += "record" + chr(9) + "65" + chr(9) + "OWN" + chr(9) + "4" + chr(9) + "subject domain, subject identity, statement owner" + chr(10)
	result += "record" + chr(9) + "66" + chr(9) + "CAP" + chr(9) + "4" + chr(9) + "module ordinal, semantic capability, available/partial/unavailable coverage" + chr(10)
