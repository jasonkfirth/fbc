/*
    Project: FreeBASIC gfxlib3
    --------------------------

    File: vulkan_blit_winner.comp

    Purpose:

        Select the last destination-independent PUT command contributing to
        each destination pixel.

    Responsibilities:

        - execute one linear source-pixel invocation for ordinary sprite
          coverage and transparent-key tests on GPU shader units
        - preserve BASIC command order for overlapping sprites
        - avoid destination-pixel command-list replay for TRANS, PSET and
          PRESET batches

    This file intentionally does NOT contain:

        - destination-read blend modes
        - final destination writes
        - same-surface snapshot handling
*/

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer WinnerPixels
{
	uint pixels[];
} winner_pixels;

layout(set = 0, binding = 1, std430) readonly buffer SourcePixels
{
	uint pixels[];
} source_pixels;

struct BlitCommand
{
	ivec4 source_rect;
	ivec4 clip;
	ivec4 destination;
	uvec4 format;
	uvec4 dimensions;
};

layout(set = 0, binding = 2, std430) readonly buffer BlitCommands
{
	BlitCommand commands[];
} blit_commands;

bool source_is_visible(BlitCommand command, uint source)
{
	/* PSET and PRESET always contribute. TRANS rejects its native key. */
	if (command.format.y != 0u)
		return true;
	if (command.format.x <= 8u)
		return (source & command.format.w) != 0u;
	if (command.format.x == 16u)
		return (source & 0xFFFFu) != 0xF81Fu;
	return (source & 0x00FFFFFFu) != 0x00FF00FFu;
}

void main(void)
{
	uint command_index = gl_WorkGroupID.z;
	BlitCommand command = blit_commands.commands[command_index];
	uint source_index = gl_GlobalInvocationID.x;
	uint source_width = uint(command.source_rect.z);
	uint source_height = uint(command.source_rect.w);
	ivec2 source_offset;
	ivec2 position;
	uint source;
	uint destination_offset;

	if (source_index >= source_width * source_height)
		return;
	source_offset = ivec2(int(source_index % source_width),
		int(source_index / source_width));
	position = command.destination.xy + source_offset;
	if ((position.x < command.clip.x) || (position.y < command.clip.y) ||
		(position.x > command.clip.z) || (position.y > command.clip.w))
		return;
	source = source_pixels.pixels[
		(uint(command.source_rect.y + source_offset.y) *
		 uint(command.destination.z)) +
		 uint(command.source_rect.x + source_offset.x)];
	if (!source_is_visible(command, source))
		return;
	destination_offset = (uint(position.y) * command.dimensions.y) +
		uint(position.x);
	atomicMax(winner_pixels.pixels[destination_offset], command_index + 1u);
}

/* end of vulkan_blit_winner.comp */
