/*
    Project: FreeBASIC gfxlib3
    --------------------------

    File: vulkan_blit.comp

    Purpose:

        Apply the built-in FreeBASIC PUT modes between device-local Vulkan
        surface buffers.

    Responsibilities:

        - map one invocation to each source pixel
        - preserve indexed, RGB565, and 32-bit blend behavior
        - clip destination writes and mask logical color depths

    This file intentionally does NOT contain:

        - custom CPU blender callbacks
        - overlap snapshot allocation
        - host-side source and destination validation
*/

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer DestinationPixels
{
	uint pixels[];
} destination_pixels;

layout(set = 0, binding = 1, std430) readonly buffer SourcePixels
{
	uint pixels[];
} source_pixels;

layout(set = 0, binding = 2, std430) readonly buffer BlitCommand
{
	ivec4 source_rect; /* x, y, width, height */
	ivec4 clip;
	ivec4 destination; /* x, y, source surface width, destination width */
	uvec4 format;      /* depth, mode, alpha, logical color mask */
} blit_command;

bool blend_pixel(uint source, uint destination, out uint result_color)
{
	uint depth = blit_command.format.x;
	uint mode = blit_command.format.y;
	uint operation_alpha = blit_command.format.z;
	uint mask = blit_command.format.w;
	uint alpha;
	uint srb;
	uint sga;
	uint drb;
	uint dga;
	uint temporary1;
	uint temporary2;
	uint overflow;

	if (mode == 1u) {
		result_color = source & mask;
		return true;
	} else if (mode == 2u) {
		result_color = (~source) & mask;
		return true;
	} else if (mode == 3u) {
		result_color = (source & destination) & mask;
	} else if (mode == 4u) {
		result_color = (source | destination) & mask;
	} else if (mode == 5u) {
		result_color = (source ^ destination) & mask;
	} else if (mode == 0u) {
		if (depth <= 8u) {
			result_color = source & mask;
			return result_color != 0u;
		} else if (depth == 16u) {
			result_color = source & 0xFFFFu;
			return result_color != 0xF81Fu;
		}
		result_color = source & mask;
		return (result_color & 0x00FFFFFFu) != 0x00FF00FFu;
	} else if (mode == 6u) {
		if (depth != 32u) {
			result_color = source & mask;
			return true;
		}
		alpha = (source >> 24) + 1u;
		srb = source & 0x00FF00FFu;
		sga = source & 0xFF00FF00u;
		drb = destination & 0x00FF00FFu;
		dga = destination & 0xFF00FF00u;
		srb = ((srb - drb) * alpha) >> 8;
		sga = ((sga >> 8) - (dga >> 8)) * alpha;
		result_color = ((drb + srb) & 0x00FF00FFu) |
			((dga + sga) & 0xFF00FF00u);
	} else if (mode == 7u) {
		alpha = operation_alpha & 0xFFu;
		if (depth <= 8u) {
			result_color = (source | destination) & mask;
		} else if (depth == 16u) {
			if ((source & 0xFFFFu) == 0xF81Fu)
				return false;
			alpha = (alpha + 7u) >> 3;
			source = ((source << 16) | source) & 0x07C0F81Fu;
			source = ((source * alpha) >> 5) & 0x07C0F81Fu;
			destination = ((destination << 16) | destination) &
				0x07C0F81Fu;
			source += destination;
			overflow = source & 0x08010020u;
			overflow -= overflow >> 5;
			source |= overflow;
			source &= 0x07C0F81Fu;
			source |= source >> 16;
			result_color = source & 0xFFFFu;
		} else {
			if ((source & 0x00FFFFFFu) == 0x00FF00FFu)
				return false;
			temporary1 = source & 0x00FF00FFu;
			temporary2 = (source >> 8) & 0x00FF00FFu;
			temporary1 = ((temporary1 * alpha) >> 8) & 0x00FF00FFu;
			temporary2 = (temporary2 * alpha) & 0xFF00FF00u;
			source = temporary1 | temporary2;
			temporary1 = source & 0x80808080u;
			temporary2 = destination & 0x80808080u;
			source = (source & 0x7F7F7F7Fu) +
				(destination & 0x7F7F7F7Fu);
			destination = temporary1;
			temporary1 |= temporary2;
			temporary2 = destination & temporary2;
			destination = temporary1 & source;
			source |= ((((temporary2 | destination) >> 7) +
				0x7F7F7F7Fu) ^ 0x7F7F7F7Fu) | temporary1;
			result_color = source;
		}
	} else if (mode == 9u) {
		alpha = operation_alpha & 0xFFu;
		if (alpha == 0u)
			return false;
		if (depth <= 8u) {
			result_color = source & mask;
			return result_color != 0u;
		} else if (depth == 16u) {
			if ((source & 0xFFFFu) == 0xF81Fu)
				return false;
			alpha = (alpha + 7u) >> 3;
			srb = source & 0xF81Fu;
			sga = source & 0x07E0u;
			drb = destination & 0xF81Fu;
			dga = destination & 0x07E0u;
			srb = ((srb - drb) * alpha) >> 5;
			sga = ((sga - dga) * alpha) >> 5;
			result_color = ((drb + srb) & 0xF81Fu) |
				((dga + sga) & 0x07E0u);
		} else {
			if ((source & 0x00FFFFFFu) == 0x00FF00FFu)
				return false;
			alpha++;
			srb = source & 0x00FF00FFu;
			sga = source & 0xFF00FF00u;
			drb = destination & 0x00FF00FFu;
			dga = destination & 0xFF00FF00u;
			srb = ((srb - drb) * alpha) >> 8;
			sga = ((sga >> 8) - (dga >> 8)) * alpha;
			result_color = ((drb + srb) & 0x00FF00FFu) |
				((dga + sga) & 0xFF00FF00u);
		}
	} else {
		return false;
	}
	return true;
}

void main(void)
{
	uint index = gl_GlobalInvocationID.x;
	uint width = uint(blit_command.source_rect.z);
	uint height = uint(blit_command.source_rect.w);
	ivec2 offset;
	ivec2 source_position;
	ivec2 destination_position;
	uint source;
	uint old_destination;
	uint result_color;

	if (index >= (width * height))
		return;
	offset = ivec2(int(index % width), int(index / width));
	source_position = blit_command.source_rect.xy + offset;
	destination_position = blit_command.destination.xy + offset;
	if ((destination_position.x < blit_command.clip.x) ||
	    (destination_position.y < blit_command.clip.y) ||
	    (destination_position.x > blit_command.clip.z) ||
	    (destination_position.y > blit_command.clip.w))
		return;
	source = source_pixels.pixels[(uint(source_position.y) *
		uint(blit_command.destination.z)) + uint(source_position.x)];
	old_destination = destination_pixels.pixels[
		(uint(destination_position.y) *
		uint(blit_command.destination.w)) + uint(destination_position.x)];
	if (blend_pixel(source, old_destination, result_color))
		destination_pixels.pixels[(uint(destination_position.y) *
			uint(blit_command.destination.w)) +
			uint(destination_position.x)] = result_color;
}

/* end of vulkan_blit.comp */
