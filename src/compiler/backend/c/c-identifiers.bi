'' Project: FreeBASIC compiler - C identifiers
'' File: backend/c/c-identifiers.bi
'' Purpose: Spell BASIC symbols as C identifiers without changing their identities.
'' Responsibilities: Escape invalid bytes and keep the generated-name namespace
''     disjoint from user symbols. Linker names are handled by declaration aliases.
'' This file intentionally does NOT contain: symbol identity or ABI changes.

private function hCNameNeedsEncoding( byval rawname as const zstring ptr ) as integer
	if( rawname = NULL ) then return FALSE
	if( left(*rawname, 5) = "fb_c_" or left(*rawname, 8) = "fb_type_" or _
	    left(*rawname, 5) = "__FB_" ) then return TRUE
	'' C reserves names beginning with an underscore and a capital letter.
	'' These MS intrinsics must keep their compiler-recognized spellings.
	if( len(*rawname) > 1 andalso (*rawname)[0] = asc("_") ) then
		select case (*rawname)[1]
		case asc("A") to asc("Z")
			select case *rawname
			case "_InterlockedExchangeAdd", "_InterlockedExchangeAdd64"
			case else
				return TRUE
			end select
		end select
	end if
	for i as integer = 0 to len(*rawname) - 1
		select case (*rawname)[i]
		case asc("A") to asc("Z"), asc("a") to asc("z"), asc("_")
		case asc("0") to asc("9")
			if( i = 0 ) then return TRUE
		case else
			return TRUE
		end select
	next
	'' GNU C11 has additional keyword spellings beyond ISO C's core set.
	select case *rawname
	case "boolean", "int8", "uint8", "int16", "uint16", "int32", "uint32", _
	     "int64", "uint64", "FBSTRING", "__builtin_va_list", "__int128", _
	     "__float128", "_Float16", "_Float32", "_Float32x", "_Float64", _
	     "_Float64x", "_Float128", "_Float128x", "_Decimal32", "_Decimal64", "_Decimal128"
		return TRUE
	case "auto", "break", "case", "char", "const", "continue", "default", _
	     "do", "double", "else", "enum", "extern", "float", "for", "goto", _
	     "if", "inline", "int", "long", "register", "restrict", "return", _
	     "short", "signed", "sizeof", "static", "struct", "switch", "typedef", _
	     "union", "unsigned", "void", "volatile", "while", "_Alignas", _
	     "_Alignof", "_Atomic", "_Bool", "_Complex", "_Generic", "_Imaginary", _
	     "_Noreturn", "_Static_assert", "_Thread_local", "asm", "typeof", _
	     "__asm", "__asm__", "__attribute", "__attribute__", "__auto_type", _
	     "__alignof", "__alignof__", "__const", "__const__", "__extension__", _
	     "__inline", "__inline__", "__restrict", "__restrict__", "__signed", _
	     "__signed__", "__thread", "__typeof", "__typeof__", "__volatile", "__volatile__"
		return TRUE
	end select
	return FALSE
end function

private function hEncodeCName( byval rawname as const zstring ptr, byref prefix as const string ) as string
	'' Each generated role has a separate prefix. Original names beginning with fb_c_
	'' are encoded too, so they cannot collide with symbols or virtual registers
	'' generated by the backend. Escape underscores as well as punctuation to
	'' make the byte encoding one-to-one, including aliases containing _24.
	dim as string result = prefix
	for i as integer = 0 to len(*rawname) - 1
		var ch = cubyte( (*rawname)[i] )
		select case ch
		case asc("A") to asc("Z"), asc("a") to asc("z"), asc("0") to asc("9")
			result += chr( ch )
		case else
			result += "_" + hex( ch, 2 )
		end select
	next
	return result
end function

private function hCUsePETlsName( byval sym as FBSYMBOL ptr, byval rawname as const zstring ptr ) as integer
	if( (env.clopt.target <> FB_COMPTARGET_WINCE) and _
	    (env.clopt.target <> FB_COMPTARGET_WIN32) ) then return FALSE
	if( (sym = NULL) or (rawname = NULL) ) then return FALSE
	if( sym->class <> FB_SYMBCLASS_VAR ) then return FALSE
	if( symbIsThreadLocal(sym) = FALSE ) then return FALSE
	if( left(*rawname, 5) = "fb_c_" or left(*rawname, 8) = "fb_type_" or _
	    left(*rawname, 5) = "__FB_" ) then return FALSE
	'' MinGW and CeGCC emulated TLS prefix an explicit asm label with an
	'' internal '*' marker, producing invalid assembler names. GCC accepts '$'
	'' in C identifiers, so retain these ordinary mangled names directly. This
	'' keeps exported TLS descriptor names compatible across object files.
	dim as integer has_dollar = FALSE
	for i as integer = 0 to len(*rawname) - 1
		select case (*rawname)[i]
		case asc("A") to asc("Z"), asc("a") to asc("z"), asc("_")
		case asc("0") to asc("9")
			if( i = 0 ) then return FALSE
		case asc("$")
			if( i = 0 ) then return FALSE
			has_dollar = TRUE
		case else
			return FALSE
		end select
	next
	return has_dollar
end function

private function hGetCId( byval sym as FBSYMBOL ptr ) as string
	var rawname = symbGetMangledName( sym )
	if( rawname = NULL ) then return ""
	if( hCUsePETlsName(sym, rawname) ) then return *rawname
	if( hCNameNeedsEncoding(rawname) = FALSE ) then return *rawname
	return hEncodeCName( rawname, "fb_c_sym_" )
end function

private function hGetCFieldId( byval fld as FBSYMBOL ptr ) as string
	'' Field names are C source tokens; the BASIC layout and names stay intact.
	var rawname = symbGetName( fld )
	if( rawname = NULL ) then return ""
	if( hCNameNeedsEncoding(rawname) = FALSE ) then return *rawname
	return hEncodeCName( rawname, "fb_c_field_" )
end function

'' end of backend/c/c-identifiers.bi
