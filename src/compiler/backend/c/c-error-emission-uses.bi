'' Project: FreeBASIC C ERROR owner emission
'' File: backend/c/c-error-emission-uses.bi
'' Purpose: Retain only labels and context bindings used by their emitted C function.
'' Responsibilities: Distinguish owner references from callback references and inspect bounded C buffers.
'' This file intentionally does NOT alter source control flow or runtime ownership.

private sub hCErrOriginalLabelReference(byval label as FBSYMBOL ptr)
	if( label = NULL ) then exit sub
	var index = hCErrLabelIndex(label)
	if( index >= 0 ) then errorplan->original_labels[index] = 1
end sub

private sub hCErrOriginalLabelTree(byval n as ASTNODE ptr)
	if( n = NULL ) then exit sub
	'' A selected handler is emitted as a callback address, not this source
	'' label address. Its label still belongs to the callback's own graph.
	if( n->class = AST_NODECLASS_CALL andalso n->sym <> NULL andalso symbGetIsRTL(n->sym) ) then
		if( hCErrName(n) = "fb_ErrorSetHandler" ) then exit sub
	end if
	select case n->class
	case AST_NODECLASS_VAR
		if( n->sym <> NULL andalso symbIsLabel(n->sym) ) then hCErrOriginalLabelReference(n->sym)
	case AST_NODECLASS_BRANCH, AST_NODECLASS_BOP, AST_NODECLASS_UOP
		hCErrOriginalLabelReference(n->op.ex)
	case AST_NODECLASS_JMPTB
		for i as integer = 0 to n->jmptb.labelcount - 1
			hCErrOriginalLabelReference(n->jmptb.labels[i])
		next
		hCErrOriginalLabelReference(n->jmptb.deflabel)
	end select
	hCErrOriginalLabelTree(n->l)
	hCErrOriginalLabelTree(n->r)
end sub

private sub hCErrMarkOriginalLabels()
	'' Unknown original transfers and implicit GOSUB return entries retain
	'' the conservative spelling. This pass only refines a proved owner graph.
	if( errorplan->original_live = NULL or errorplan->handlercount = 0 ) then exit sub
	if( symbGetProcStatGosub(errorplan->owner) ) then exit sub
	errorplan->original_labels = callocate(errorplan->count)
	if( errorplan->original_labels = NULL ) then exit sub
	hCErrOriginalLabelReference(astGetProc()->block.initlabel)
	if( errorplan->can_transfer ) then hCErrOriginalLabelReference(errorplan->cleanup_label)
	for i as integer = 0 to errorplan->count - 1
		if( errorplan->recovery_ids <> NULL andalso errorplan->recovery_ids[i] <> 0 ) then
			errorplan->original_labels[i] = 1
		end if
		if( errorplan->original_live[i] <> 0 ) then hCErrOriginalLabelTree(errorplan->statements[i])
	next
end sub

private sub hCErrTrimUnusedContext(byval first as uinteger, byval following as uinteger)
	'' Debug output retains the context alias for inspecting captured values.
	if( env.clopt.debuginfo ) then exit sub
	var header = @ctx.sections(errordeclsection)
	var body = @ctx.sections(ctx.section)
	if( first > following orelse following > header->bufferlen ) then
		errReportEx(FB_ERRMSG_INTERNAL, "C callback context declaration boundary")
		exit sub
	end if
	dim as uinteger found
	const CONTEXT_NAME = "fb_error_capture"
	'' Search both declaration and executable sections, excluding the alias
	'' itself. A conservative substring match can retain an unnecessary alias,
	'' but cannot discard a use generated by another emitter helper or macro.
	if( hCAbiFind(header->buffer, first, 0, strptr(CONTEXT_NAME), len(CONTEXT_NAME), found) ) then exit sub
	if( hCAbiFind(header->buffer, header->bufferlen, following, strptr(CONTEXT_NAME), len(CONTEXT_NAME), found) ) then exit sub
	if( body->old = FALSE andalso hCAbiFind(body->buffer, body->bufferlen, 0, strptr(CONTEXT_NAME), len(CONTEXT_NAME), found) ) then exit sub
	dim as string replacement
	for i as integer = 1 to header->indent
		replacement += TABCHAR
	next
	'' The callback ABI always supplies this slot. Explicitly discard its value
	'' when the outlined body does not inspect it; no capture object is read.
	'' This also keeps the required named parameter valid in pre-C23 definitions.
	replacement += "(void)fb_error_opaque;" + NEWLINE
	var bytes = cuint(len(replacement))
	var old_body_bytes = body->bufferlen
	sectionAppend(body, strptr(replacement), bytes)
	if( body->bufferlen < old_body_bytes orelse body->bufferlen - old_body_bytes <> bytes ) then
		errReportEx(FB_ERRMSG_INTERNAL, "C callback context discard insertion")
		exit sub
	end if
	'' Header declarations stay before every executable statement. The discard
	'' is the first body statement, preceding the jump into the handler graph.
	memmove(body->buffer + bytes, body->buffer, old_body_bytes)
	memcpy(body->buffer, strptr(replacement), bytes)
	if( ctx.procentrysection = ctx.section andalso ctx.procentrybytes > 0 ) then
		ctx.procentryoffset += bytes
	end if
	memmove(header->buffer + first, header->buffer + following, header->bufferlen - following)
	header->bufferlen -= following - first
end sub

'' end of backend/c/c-error-emission-uses.bi
