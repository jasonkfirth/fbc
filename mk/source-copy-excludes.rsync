# FreeBASIC source tree rsync excludes
#
# These patterns keep generated build, staging, packaging, and log content out
# of isolated worktrees and bootstrap source archives. Re-importing those
# trees can recursively copy previous staging results into new builds and
# waste large amounts of disk space.

.*
/fbc.exe
/freebasic-dist.tar
/freebasic-package.tar
/freebasic-package.zip
FreeBASIC-*-source-bootstrap-*.tar.*
*.install_manifest
*.log
*.tmp
.maketests-tmp/
xbox_emulator/
xbox_emulator_xemu/
bin/fbc*
bootstrap/fbc*
/build/
dist/
/lib/freebasic/
examples/**/*.a
examples/**/*.asm
examples/**/*.dll
examples/**/*.exe
examples/**/*.o
examples/**/*.obj
examples/**/*.stderr.txt
examples/**/*.stdout.txt
examples/**/obj/
examples/manual/proguide/hello.txt
maketests-log/
obj/
out/
package-root/
package-root*/
packages/
pkgroot/
pkgroot*/
stage/
src/*/obj/
test-run-log/
tests/**/*.asm
tests/**/*.exe
tests/**/*.log
tests/**/*.o
tests/**/*.obj
tests/warnings/r/**/*.txt
tests/**/*.tmp
tests/*.log
tests/*.tmp
