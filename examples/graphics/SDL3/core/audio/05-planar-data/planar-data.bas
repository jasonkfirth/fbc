declare function SDL_AppInit cdecl(byval appstate as any ptr ptr, byval argc as long, byval argv as zstring ptr ptr) as SDL_AppResult
declare function SDL_AppEvent cdecl(byval appstate as any ptr, byval event as SDL_Event ptr) as SDL_AppResult
declare sub render_button cdecl(byval rect as const SDL_FRect ptr, byval str_ as const zstring ptr, byval button_value as long)
declare function SDL_AppIterate cdecl(byval appstate as any ptr) as SDL_AppResult
declare sub SDL_AppQuit cdecl(byval appstate as any ptr, byval result as SDL_AppResult)

'' This function runs once at startup.
function SDL_AppInit cdecl(byval appstate as any ptr ptr, byval argc as long, byval argv as zstring ptr ptr) as SDL_AppResult
	scope
		dim spec as SDL_AudioSpec = type<SDL_AudioSpec>(SDL_AUDIO_U8, 2, 4000)
		'' Uint8 data, stereo, 4000Hz.
		SDL_SetAppMetadata(strptr("Example Audio Planar Data"), strptr("1.0"), strptr("com.example.audio-planar-data"))
		if (SDL_Init((SDL_INIT_VIDEO or SDL_INIT_AUDIO)) = 0) then
			scope
				SDL_Log_(strptr("Couldn't initialize SDL: %s"), SDL_GetError())
				return SDL_APP_FAILURE
			end scope
		end if
		if (SDL_CreateWindowAndRenderer(strptr("examples/audio/planar-data"), 640, 480, SDL_WINDOW_RESIZABLE, @(window_), @(renderer)) = 0) then
			scope
				SDL_Log_(strptr("Couldn't create window/renderer: %s"), SDL_GetError())
				return SDL_APP_FAILURE
			end scope
		end if
		SDL_SetRenderLogicalPresentation(renderer, 640, 480, SDL_LOGICAL_PRESENTATION_LETTERBOX)
		stream = SDL_OpenAudioDeviceStream((SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK), @(spec), cptr(SDL_AudioStreamCallback, 0), (cptr(any ptr, 0)))
		if (stream = 0) then
			scope
				SDL_Log_(strptr("Couldn't open audio device stream: %s"), SDL_GetError())
				return SDL_APP_FAILURE
			end scope
		end if
		SDL_ResumeAudioStreamDevice(stream)
		'' SDL_OpenAudioDeviceStream starts the device paused. Resume it!
		return SDL_APP_CONTINUE
	end scope
end function

'' This function runs when a new event (mouse input, keypresses, etc) occurs.
function SDL_AppEvent cdecl(byval appstate as any ptr, byval event as SDL_Event ptr) as SDL_AppResult
	scope
		SDL_ConvertEventToRenderCoordinates(renderer, event)
		if (event->type = SDL_EVENT_QUIT) then
			scope
				return SDL_APP_SUCCESS
			end scope
		else
			if (event->type = SDL_EVENT_MOUSE_BUTTON_DOWN) then
				scope
					if (playing_sound = 0) then
						scope
							'' nothing currently playing?
							dim point_ as SDL_FPoint = type<SDL_FPoint>(event->button.x, event->button.y)
							if SDL_PointInRectFloat(@(point_), @(rect_left_button)) then
								scope
									'' clicked left button?
									dim planes(0 to 1) as const Uint8 ptr = {@left_samples(0), cptr(const Uint8 ptr, 0)}
									'' specify NULL to say "this specific channel is silent"
									SDL_PutAudioStreamPlanarData(stream, cptr(const any ptr ptr, @planes(0)), (-1), (((sizeof(Uint8) * 1870) \ sizeof((left_samples(0))))))
									SDL_FlushAudioStream(stream)
									'' that's all we're playing until it completes.
									playing_sound = (-1)
								end scope
							else
								if SDL_PointInRectFloat(@(point_), @(rect_right_button)) then
									scope
										'' clicked right button?
										dim planes(0 to 1) as const Uint8 ptr = {cptr(const Uint8 ptr, 0), @right_samples(0)}
										'' specify NULL to say "this specific channel is silent"
										SDL_PutAudioStreamPlanarData(stream, cptr(const any ptr ptr, @planes(0)), (-1), (((sizeof(Uint8) * 1777) \ sizeof((right_samples(0))))))
										SDL_FlushAudioStream(stream)
										'' that's all we're playing until it completes.
										playing_sound = 1
									end scope
								end if
							end if
						end scope
					end if
				end scope
			end if
		end if
		return SDL_APP_CONTINUE
	end scope
end function

sub render_button cdecl(byval rect as const SDL_FRect ptr, byval str_ as const zstring ptr, byval button_value as long)
	scope
		dim x as single
		dim y as single
		if (playing_sound = button_value) then
			scope
				SDL_SetRenderDrawColor(renderer, 0, 255, 0, 255)
			end scope
		else
			scope
				SDL_SetRenderDrawColor(renderer, 0, 0, 255, 255)
			end scope
		end if
		SDL_RenderFillRect(renderer, rect)
		SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255)
		x = (rect->x + ((((rect->w - ((SDL_DEBUG_TEXT_FONT_CHARACTER_SIZE * SDL_strlen(str_))))) / 2.0f)))
		y = (rect->y + ((((rect->h - SDL_DEBUG_TEXT_FONT_CHARACTER_SIZE)) / 2.0f)))
		SDL_RenderDebugText(renderer, x, y, str_)
	end scope
end sub

'' This function runs once per frame, and is the heart of the program.
function SDL_AppIterate cdecl(byval appstate as any ptr) as SDL_AppResult
	scope
		if playing_sound then
			scope
				if (SDL_GetAudioStreamQueued(stream) = 0) then
					scope
						'' sound is done? We can play a new sound now.
						playing_sound = 0
					end scope
				end if
			end scope
		end if
		SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255)
		SDL_RenderClear(renderer)
		render_button(@(rect_left_button), strptr("LEFT"), (-1))
		render_button(@(rect_right_button), strptr("RIGHT"), 1)
		SDL_RenderPresent(renderer)
		return SDL_APP_CONTINUE
	end scope
end function

'' This function runs once at shutdown.
sub SDL_AppQuit cdecl(byval appstate as any ptr, byval result as SDL_AppResult)
	scope
		SDL_DestroyAudioStream(stream)
	end scope
end sub

