# Project: FreeBASIC test suite
# File: import-data.bmk
# Purpose: Run the Windows IMPORT data test in the standard log-test profile.
# Responsibilities: Build its C DLL and import library for Windows targets.
# This file intentionally does NOT contain: import declarations or DLL data.
# TEST_MODE : MULTI_MODULE_OK

ifeq ($(TESTS_TARGET_OS),win32)
MAIN := ../bindings/import-data.bas
EXTRA_OBJS := ../bindings/libimport-data.dll.a
FBC_LFLAGS += -p $(SRCDIR)../bindings

$(SRCDIR)../bindings/libimport-data.dll.a : $(SRCDIR)../bindings/import-data.c
	$(CC) -Wall -Wextra -Werror -shared $< \
		-Wl,--out-implib,$@ -o $(SRCDIR)../bindings/import-data.dll
else
MAIN := import-data-noop.bas
endif

# end of import-data.bmk
