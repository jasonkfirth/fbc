+static char *
+pex_aros_filename (const char *source)
+{
+  char *filename;
+  char *cursor;
+  char *search_candidate = NULL;
+  size_t size;
+
+  if (strstr (source, "/../") != NULL)
+    {
+      BPTR developer_lock;
+      const char *basename = strrchr (source, '/');
+
+      search_candidate = XNEWVEC (char, strlen (basename + 1) + 15);
+      sprintf (search_candidate, "Developer:bin/%s", basename + 1);
+      developer_lock = Lock ((CONST_STRPTR) search_candidate, SHARED_LOCK);
+      if (developer_lock != BNULL)
+        {
+          UnLock (developer_lock);
+          source = search_candidate;
+        }
+    }
+
+  if (strchr (source, '/') == NULL && strchr (source, ':') == NULL)
+    {
+      BPTR developer_lock;
+      const char *path;
+
+      search_candidate = XNEWVEC (char, strlen (source) + 15);
+      sprintf (search_candidate, "Developer:bin/%s", source);
+      developer_lock = Lock ((CONST_STRPTR) search_candidate, SHARED_LOCK);
+      if (developer_lock != BNULL)
+        {
+          UnLock (developer_lock);
+          source = search_candidate;
+        }
+
+      path = getenv ("PATH");
+
+      if (developer_lock == BNULL && path != NULL)
+        {
+          char *path_copy = XNEWVEC (char, strlen (path) + 1);
+          char *path_cursor;
+          char *path_entry;
+
+          strcpy (path_copy, path);
+          path_cursor = path_copy;
+          while ((path_entry = strsep (&path_cursor, ",:")) != NULL)
+            {
+              BPTR lock;
+              size_t candidate_size = strlen (path_entry) + strlen (source) + 2;
+
+              free (search_candidate);
+              search_candidate = XNEWVEC (char, candidate_size);
+              snprintf (search_candidate, candidate_size, "%s/%s",
+                        *path_entry != '\0' ? path_entry : ".", source);
+              lock = Lock ((CONST_STRPTR) search_candidate, SHARED_LOCK);
+              if (lock != BNULL)
+                {
+                  UnLock (lock);
+                  source = search_candidate;
+                  break;
+                }
+            }
+          free (path_copy);
+        }
+    }
+
+  size = strlen (source) + 1;
+
+  filename = XNEWVEC (char, size);
+  cursor = filename;
+  if (source[0] == '/' && strchr (source + 1, '/') != NULL)
+    {
+      const char *separator;
+
+      ++source;
+      separator = strchr (source, '/');
+      memcpy (cursor, source, separator - source);
+      cursor += separator - source;
+      *cursor++ = ':';
+      source = separator + 1;
+    }
+  while (*source != '\0')
+    *cursor++ = *source++;
+  *cursor = '\0';
+
+  /*
+   * GCC builds subordinate-program paths relative to its driver directory.
+   * AROS Lock() does not resolve those parent components, so remove them
+   * lexically before asking dos.library for the canonical native path.
+   */
+  while ((cursor = strstr (filename, "/../")) != NULL)
+    {
+      char *component = cursor;
+
+      while (component > filename
+             && component[-1] != ':' && component[-1] != '/')
+        --component;
+      if (component == cursor)
+        break;
+      memmove (component, cursor + 4, strlen (cursor + 4) + 1);
+    }
+  while ((cursor = strstr (filename, "/./")) != NULL)
+    memmove (cursor, cursor + 2, strlen (cursor + 2) + 1);
+
+  {
+    BPTR lock = Lock ((CONST_STRPTR) filename, SHARED_LOCK);
+
+    if (lock != BNULL)
+      {
+        char *canonical = XNEWVEC (char, 4096);
+
+        if (NameFromLock (lock, (STRPTR) canonical, 4096))
+          {
+            free (filename);
+            filename = canonical;
+          }
+        else
+          free (canonical);
+        UnLock (lock);
+      }
+  }
+
+  free (search_candidate);
+
+  return filename;
+}
+
+static char *
+pex_aros_arguments (char * const *argv)
+{
+  char *arguments;
+  char *cursor;
+  char * const *argument;
+  size_t size = 2;
+
+  for (argument = argv + 1; *argument != NULL; ++argument)
+    {
+      const char *source;
+
+      size += strlen (*argument) + 3;
+      for (source = *argument; *source != '\0'; ++source)
+	if (*source == '\n' || *source == '"' || *source == '*')
+	  ++size;
+    }
+
+  arguments = XNEWVEC (char, size);
+  cursor = arguments;
+  for (argument = argv + 1; *argument != NULL; ++argument)
+    {
+      const char *source;
+
+      if (argument != argv + 1)
+	*cursor++ = ' ';
+
+      *cursor++ = '"';
+      for (source = *argument; *source != '\0'; ++source)
+	{
+	  if (*source == '\n' || *source == '"' || *source == '*')
+	    {
+	      *cursor++ = '*';
+	      *cursor++ = (*source == '\n') ? 'N' : *source;
+	    }
+	  else
+	    *cursor++ = *source;
+	}
+      *cursor++ = '"';
+    }
+  *cursor++ = '\n';
+  *cursor = '\0';
+
+  return arguments;
+}
