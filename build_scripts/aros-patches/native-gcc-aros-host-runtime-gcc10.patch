# Project: FreeBASIC AROS release workflow
# ----------------------------------------
#
# File: native-gcc-aros-host-runtime-gcc10.patch
#
# Purpose:
#
#     Make GCC 10 programs hosted by AROS usable as the native FreeBASIC
#     backend on x86_64 systems.
#
# Responsibilities:
#
#     - optimize AROS-hosted GCC programs and select the Unix-style entry point
#     - avoid unavailable AROS random-device and process-timing interfaces
#     - avoid POSIX stream and install-prefix probes that are invalid on AROS
#     - avoid POSIX path canonicalization for native AROS command names
#     - run GCC child programs synchronously through dos.library
#     - resolve native child tools below the Developer: assign
#
# This file intentionally does NOT alter generated target code or cross-host
# GCC process behavior.
#
--- a/gcc/config/x-aros
+++ b/gcc/config/x-aros
@@ -0,0 +1,11 @@
+# AROS-hosted GCC programs are release tools, not bootstrap diagnostics.
+# The generated makefiles receive empty command-line optimization variables,
+# so override them here after GCC has processed those command-line values.
+override CFLAGS += -O2
+override CXXFLAGS += -O2
+
+# AROS's POSIX compatibility startup supplies argv, environment handling, and
+# Unix-style path conversion used throughout GCC and libiberty.
+override LDFLAGS += -nix
+
+# end of x-aros
