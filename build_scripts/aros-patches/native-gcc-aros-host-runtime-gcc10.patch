+#ifdef __AROS__
+  /* AROS command streams are not necessarily POSIX file descriptors.  */
+  value = value ? value - 1 : INT_MAX;
+#else
   value = value ? value - 1 
     : (isatty (fileno (pp_buffer (context->printer)->stream))
        ? get_terminal_width () - 1: INT_MAX);
+#endif
   
   if (value <= 0) 
     value = INT_MAX;
