      "project": "fb-ext-lib",
      "command": [
        "make",
        "--no-print-directory",
        "-j1",
        "build",
        "FBC={wrapper}",
        "BITS=64",
        "ARCH=x86"
      ]
    },
    {
      "project": "fbsound",
      "command": [
        "make",
        "--no-print-directory",
        "-B",
        "-j2",
        "TARGET=lin64",
        "FBC={wrapper}",
        "FBCINC={toolchain}/inc",
        "build"
      ]
    },
    {
      "project": "fb-VNC",
      "command": [
        "make",
        "--no-print-directory",
        "-B",
        "-j2",
        "all",
        "FBC={wrapper}"
      ]
    },
