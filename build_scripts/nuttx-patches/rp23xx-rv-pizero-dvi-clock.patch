+config RP23XX_RV_PIZERO_DVI_CLOCK
+	bool "Use RP2350-PiZero DVI clock profile"
+	default n
+	depends on RP23XX_RV_RP2350B
+	---help---
+		The Waveshare RP2350-PiZero DVI connector is driven by a PIO
+		serializer in the vendor samples.  The 640x480 DVI timing used
+		during bring-up needs clk_sys at 252 MHz so that one PIO cycle
+		matches one TMDS bit.
+
+		This option is intended for the temporary FreeBASIC hardware
+		image, not as a general board default.
+
 config RP23XX_RV_DMAC
 	bool "DMAC support"
 	default y
