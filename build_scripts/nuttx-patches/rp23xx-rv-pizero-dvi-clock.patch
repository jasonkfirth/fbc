+#  define RP23XX_DVI_POWMAN_PASSWORD 0x5afe0000u
+#  define RP23XX_DVI_POWMAN_VREG_CTRL_UNLOCK (1u << 13)
+#  define RP23XX_DVI_POWMAN_VREG_UPDATE_IN_PROGRESS (1u << 15)
+#  define RP23XX_DVI_POWMAN_VREG_VSEL_MASK 0x000001f0u
