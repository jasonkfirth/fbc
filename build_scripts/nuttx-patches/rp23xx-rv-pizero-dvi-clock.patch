@@ -69,7 +91,44 @@
 /****************************************************************************
  * Private Functions
  ****************************************************************************/
 
+#ifdef CONFIG_RP23XX_RV_PIZERO_DVI_CLOCK
+static void rp23xx_pizero_dvi_vreg_init(void)
+{
+  volatile unsigned int delay;
+
+  /* The PicoDVI-based board demo raises VREG before switching clk_sys to
+   * 252 MHz. Keep the same guardrail here so the temporary DVI profile does
+   * not ask the RP2350 core to run above the default-voltage clock range.
+   */
+
+  setbits_reg32(RP23XX_DVI_POWMAN_PASSWORD |
+                RP23XX_DVI_POWMAN_VREG_CTRL_UNLOCK,
+                RP23XX_DVI_POWMAN_VREG_CTRL);
+
+  while ((getreg32(RP23XX_DVI_POWMAN_VREG) &
+          RP23XX_DVI_POWMAN_VREG_UPDATE_IN_PROGRESS) != 0)
+    ;
+
+  modbits_reg32(RP23XX_DVI_POWMAN_PASSWORD | RP23XX_DVI_VREG_1V20,
+                RP23XX_DVI_POWMAN_PASSWORD |
+                RP23XX_DVI_POWMAN_VREG_VSEL_MASK,
+                RP23XX_DVI_POWMAN_VREG);
+
+  while ((getreg32(RP23XX_DVI_POWMAN_VREG) &
+          RP23XX_DVI_POWMAN_VREG_UPDATE_IN_PROGRESS) != 0)
+    ;
+
+  /* The SDK demo sleeps for 10 ms after changing VREG. Timers are not
+   * configured yet in this path, so use a small volatile delay instead.
+   */
+
+  for (delay = 0; delay < 120000; delay++)
+    ;
+}
+#else
+#  define rp23xx_pizero_dvi_vreg_init()
+#endif
+
 static void tick_start(int tick, int cycles)
 {
