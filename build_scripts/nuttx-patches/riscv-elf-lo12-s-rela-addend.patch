--- libs/libc/machine/risc-v/arch_elf.c
+++ libs/libc/machine/risc-v/arch_elf.c
@@ -448,7 +448,7 @@
 
           _calc_imm(offset, &imm_hi, &imm_lo);
 
-          _add_val((uint16_t *)addr, (int32_t)imm_lo << 20);
+          _add_val((uint16_t *)addr, ((uint32_t)imm_lo & 0x0fff) << 20);
         }
         break;
 
@@ -471,7 +471,7 @@
           _calc_imm(offset, &imm_hi, &imm_lo);
 
-          val = (((int32_t)imm_lo >> 5) << 25) +
-                (((int32_t)imm_lo & 0x1f) << 7);
+          val = (((uint32_t)imm_lo & 0x0fe0) << 20) |
+                (((uint32_t)imm_lo & 0x001f) << 7);
 
           binfo("imm_lo=%ld (%lx), val=%" PRIx32 "\n", imm_lo, imm_lo, val);
 
@@ -501,14 +501,14 @@
           if (!_valid_hi20_imm(imm_hi))
             {
               berr("ERROR: %s at %08" PRIxPTR " bad:%08" PRIxPTR "\n",
-                   _get_rname(relotype), addr, (uintptr_t)imm_hi << 12);
+                   _get_rname(relotype), addr, ((uintptr_t)imm_hi & 0xfffff) << 12);
 
               return -EINVAL;
             }
 
           /* Adjust auipc (add upper immediate to pc) : 20bit */
 
-          _add_val((uint16_t *)addr, imm_hi << 12);
+          _add_val((uint16_t *)addr, ((uint32_t)imm_hi & 0xfffff) << 12);
 
           /* Add the hi20 value to the cache */
 
@@ -535,18 +535,18 @@
           if (!_valid_hi20_imm(imm_hi))
             {
               berr("ERROR: %s at %08" PRIxPTR " bad:%08" PRIxPTR "\n",
-                   _get_rname(relotype), addr, (uintptr_t)imm_hi << 12);
+                   _get_rname(relotype), addr, ((uintptr_t)imm_hi & 0xfffff) << 12);
 
               return -EINVAL;
             }
 
           /* Adjust auipc (add upper immediate to pc) : 20bit */
 
-          _add_val((uint16_t *)addr, imm_hi << 12);
+          _add_val((uint16_t *)addr, ((uint32_t)imm_hi & 0xfffff) << 12);
 
           /* Adjust imm for CALL (JALR) : I-type */
 
-          _add_val((uint16_t *)(addr + 4), (int32_t)imm_lo << 20);
+          _add_val((uint16_t *)(addr + 4), ((uint32_t)imm_lo & 0x0fff) << 20);
         }
         break;
 
@@ -618,7 +618,7 @@
           if (!_valid_hi20_imm(imm_hi))
             {
               berr("ERROR: %s at %08" PRIxPTR " bad:%08" PRIxPTR "\n",
-                   _get_rname(relotype), addr, (uintptr_t)imm_hi << 12);
+                   _get_rname(relotype), addr, ((uintptr_t)imm_hi & 0xfffff) << 12);
 
               return -EINVAL;
             }
@@ -645,7 +645,7 @@
           long imm_hi;
           long imm_lo;
           _calc_imm(offset, &imm_hi, &imm_lo);
-          insn = (insn & 0x000fffff) | (imm_lo << 20);
+          insn = (insn & 0x000fffff) | (((uint32_t)imm_lo & 0x0fff) << 20);
 
           _set_val((uint16_t *)addr, insn);
         }
@@ -653,6 +653,7 @@
 
       case R_RISCV_LO12_S:
         {
+          uint32_t insn;
           binfo("%s at %08" PRIxPTR " [%08" PRIx32 "] "
                 "to sym=%p st_value=%" PRIxPTR "\n",
                 _get_rname(relotype),
@@ -671,12 +672,21 @@
           _calc_imm(offset, &imm_hi, &imm_lo);
 
           uint32_t val =
-              (((int32_t)imm_lo >> 5) << 25) +
-              (((int32_t)imm_lo & 0x1f) << 7);
+              (((uint32_t)imm_lo & 0x0fe0) << 20) |
+              (((uint32_t)imm_lo & 0x001f) << 7);
 
           binfo("imm_lo=%ld (%lx), val=%" PRIx32 "\n", imm_lo, imm_lo, val);
 
-          _add_val((uint16_t *)addr, val);
+          /* RISC-V RELA entries carry the addend in r_addend.  The assembler
+           * may still leave the same offset encoded in the S-type immediate
+           * field, for example sw a4,4(a5) with an EXT_SYMBOL + 4
+           * relocation.  Replace that split immediate instead of adding to
+           * it, otherwise non-zero store offsets are applied twice.
+           */
+
+          insn = _get_val((uint16_t *)addr);
+          insn = (insn & 0x01fff07f) | val;
+          _set_val((uint16_t *)addr, insn);
         }
         break;
 
