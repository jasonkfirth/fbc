+static int rp23xx_usbhost_ep0configure(FAR struct usbhost_driver_s *drvr,
+                                       usbhost_ep_t ep0, uint8_t funcaddr,
+                                       uint8_t speed,
+                                       uint16_t maxpacketsize)
+{
+  FAR struct rp23xx_usbhost_ep_s *ep = rp23xx_usbhost_ep(ep0);
+
+  DEBUGASSERT(ep != NULL);
+  ep->funcaddr = funcaddr;
+  ep->speed = speed;
+  ep->maxpacket = maxpacketsize ? maxpacketsize : RP23XX_USBHOST_MAX_PACKET;
+  ep->nextpid = 0;
+  return OK;
+}
