+ ****************************************************************************/
+
+#define RP23XX_USBHOST_DPRAM_SIZE          4096
+#define RP23XX_USBHOST_MAX_ENDPOINTS       16
+#define RP23XX_USBHOST_INT_ENDPOINTS       15
+#define RP23XX_USBHOST_MAX_PACKET          64
+
+#ifndef CONFIG_RP23XX_RV_USBHOST_DESCSIZE
+#  define CONFIG_RP23XX_RV_USBHOST_DESCSIZE 512
+#endif
+
+#define RP23XX_USBHOST_EPX_CTRL            RP23XX_USBCTRL_DPSRAM_EP_CTRL(2)
+#define RP23XX_USBHOST_EPX_BUF_CTRL        RP23XX_USBCTRL_DPSRAM_EP_BUF_CTRL(0)
+#define RP23XX_USBHOST_EPX_DATA            RP23XX_USBCTRL_DPSRAM_DATA_BUF
+
+#define RP23XX_USBHOST_INT_EP_CTRL(n)      RP23XX_USBCTRL_DPSRAM_EP_CTRL((n) + 2)
+#define RP23XX_USBHOST_INT_BUF_CTRL(n)     RP23XX_USBCTRL_DPSRAM_EP_BUF_CTRL(n)
+#define RP23XX_USBHOST_INT_DATA(n)         (RP23XX_USBCTRL_DPSRAM_BASE + \
+                                            RP23XX_USBHOST_DPRAM_SIZE - \
+                                            ((n) * RP23XX_USBHOST_MAX_PACKET))
+
+#define RP23XX_USBHOST_SIE_BASE            (RP23XX_USBCTRL_REGS_SIE_CTRL_PULLDOWN_EN | \
+                                            RP23XX_USBCTRL_REGS_SIE_CTRL_EP0_INT_1BUF)
+#define RP23XX_USBHOST_SIE_BASE_MASK       (RP23XX_USBHOST_SIE_BASE | \
+                                            RP23XX_USBCTRL_REGS_SIE_CTRL_SOF_EN | \
+                                            RP23XX_USBCTRL_REGS_SIE_CTRL_KEEP_ALIVE_EN)
+
+#define RP23XX_USBHOST_EPX_BUFF_STATUS     RP23XX_USBCTRL_REGS_BUFF_STATUS_EP0_IN
+
+#define RP23XX_USBHOST_INIT_INTS           (RP23XX_USBCTRL_REGS_INTR_BUFF_STATUS | \
+                                            RP23XX_USBCTRL_REGS_INTR_HOST_CONN_DIS | \
+                                            RP23XX_USBCTRL_REGS_INTR_HOST_RESUME | \
+                                            RP23XX_USBCTRL_REGS_INTR_STALL | \
+                                            RP23XX_USBCTRL_REGS_INTR_TRANS_COMPLETE | \
+                                            RP23XX_USBCTRL_REGS_INTR_ERROR_RX_TIMEOUT | \
+                                            RP23XX_USBCTRL_REGS_INTR_ERROR_DATA_SEQ)
+
+#define RP23XX_USBHOST_ERROR_INTS          (RP23XX_USBCTRL_REGS_INTR_STALL | \
+                                            RP23XX_USBCTRL_REGS_INTR_ERROR_RX_TIMEOUT | \
+                                            RP23XX_USBCTRL_REGS_INTR_ERROR_DATA_SEQ)
+
+#define RP23XX_USBHOST_NAK_POLL            ((300 << RP23XX_USBCTRL_REGS_NAK_POLL_DELAY_FS_SHIFT) | \
+                                            300)
+
+#define RP23XX_USBHOST_SPEED(stat)         (((stat) & \
+                                            RP23XX_USBCTRL_REGS_SIE_STATUS_SPEED_MASK) >> \
+                                            RP23XX_USBCTRL_REGS_SIE_STATUS_SPEED_SHIFT)
+
+#define RP23XX_USBHOST_SPEED_DISCONNECT    0
+#define RP23XX_USBHOST_SPEED_LOW           1
+#define RP23XX_USBHOST_SPEED_FULL          2
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+enum rp23xx_usbhost_epstate_e
+{
+  RP23XX_USBHOST_EP_IDLE = 0,
+  RP23XX_USBHOST_EP_ACTIVE,
+  RP23XX_USBHOST_EP_DONE
+};
+
+struct rp23xx_usbhost_s;
+
+struct rp23xx_usbhost_ep_s
+{
+  bool allocated;
+  bool in;
+  bool interrupt;
+  bool need_preamble;
+  bool setup;
+  bool zlp;
+  bool cancelled;
+  uint8_t epno;
+  uint8_t funcaddr;
+  uint8_t speed;
+  uint8_t xfrtype;
+  uint8_t interval;
+  uint8_t intnum;
+  uint8_t nextpid;
+  uint16_t maxpacket;
+  uintptr_t dpram;
+  size_t buflen;
+  size_t remaining;
+  size_t xferred;
+  FAR uint8_t *buffer;
+  ssize_t result;
+  enum rp23xx_usbhost_epstate_e state;
+  usbhost_asynch_t callback;
+  FAR void *arg;
+  sem_t waitsem;
+  FAR struct rp23xx_usbhost_s *priv;
+};
+
+struct rp23xx_usbhost_s
+{
+  struct usbhost_driver_s drvr;
+  struct usbhost_connection_s conn;
+  struct usbhost_roothubport_s rhport;
+  struct usbhost_devaddr_s devgen;
+  mutex_t lock;
+  spinlock_t irqlock;
+  sem_t pscsem;
+  bool initialized;
+  bool connected;
+  bool change;
+#ifdef CONFIG_USBHOST_HUB
+  FAR struct usbhost_hubport_s *hport;
+#endif
+  FAR struct rp23xx_usbhost_ep_s *epx;
+  struct rp23xx_usbhost_ep_s ep[RP23XX_USBHOST_MAX_ENDPOINTS];
+};
