+static int rp23xx_usbhost_epalloc(FAR struct usbhost_driver_s *drvr,
+                                  FAR const struct usbhost_epdesc_s *epdesc,
+                                  FAR usbhost_ep_t *ep)
+{
+  FAR struct rp23xx_usbhost_s *priv =
+    (FAR struct rp23xx_usbhost_s *)drvr;
+  FAR struct rp23xx_usbhost_ep_s *privep = NULL;
+  uint8_t intnum;
+  int i;
+  int ret;
+
+  DEBUGASSERT(priv != NULL && epdesc != NULL && ep != NULL);
+
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  for (i = 1; i < RP23XX_USBHOST_MAX_ENDPOINTS; i++)
+    {
+      if (!priv->ep[i].allocated)
+        {
+          privep = &priv->ep[i];
+          break;
+        }
+    }
+
+  if (privep == NULL)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -ENOMEM;
+    }
+
+  memset(privep, 0, sizeof(*privep));
+  privep->priv = priv;
+  privep->allocated = true;
+  privep->in = epdesc->in;
+  privep->epno = epdesc->addr & USB_EPNO_MASK;
+  privep->funcaddr = epdesc->hport->funcaddr;
+  privep->speed = epdesc->hport->speed;
+  privep->xfrtype = epdesc->xfrtype;
+  privep->interval = epdesc->interval ? epdesc->interval : 1;
+  privep->maxpacket = epdesc->mxpacketsize ?
+                      epdesc->mxpacketsize : RP23XX_USBHOST_MAX_PACKET;
+  if (privep->maxpacket > RP23XX_USBHOST_MAX_PACKET)
+    {
+      privep->maxpacket = RP23XX_USBHOST_MAX_PACKET;
+    }
+
+  privep->need_preamble = rp23xx_usbhost_need_preamble(epdesc->hport);
+  nxsem_init(&privep->waitsem, 0, 0);
+
+  if (privep->xfrtype == USB_EP_ATTR_XFER_INT)
+    {
+      for (intnum = 1; intnum <= RP23XX_USBHOST_INT_ENDPOINTS; intnum++)
+        {
+          if ((getreg32(RP23XX_USBCTRL_REGS_INT_EP_CTRL) &
+               (1u << intnum)) == 0)
+            {
+              break;
+            }
+        }
+
+      if (intnum > RP23XX_USBHOST_INT_ENDPOINTS)
+        {
+          nxmutex_unlock(&priv->lock);
+          return -ENOMEM;
+        }
+
+      privep->interrupt = true;
+      privep->intnum = intnum;
+      privep->dpram = RP23XX_USBHOST_INT_DATA(intnum);
+
+      putreg32(RP23XX_USBCTRL_DPSRAM_EP_CTRL_ENABLE |
+               RP23XX_USBCTRL_DPSRAM_EP_CTRL_INT_1BUF |
+               RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_TYPE_INTR |
+               (((uint32_t)privep->interval - 1) << 18) |
+               ((uint32_t)(privep->dpram - RP23XX_USBCTRL_DPSRAM_BASE) &
+                RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_ADDR_MASK),
+               RP23XX_USBHOST_INT_EP_CTRL(intnum));
+
+      putreg32((uint32_t)privep->funcaddr |
+               ((uint32_t)privep->epno <<
+                RP23XX_USBCTRL_REGS_ADDR_ENDPN_ENDPOINT_SHIFT) |
+               (privep->in ? 0 :
+                RP23XX_USBCTRL_REGS_ADDR_ENDPN_INTEP_DIR) |
+               (privep->need_preamble ?
+                RP23XX_USBCTRL_REGS_ADDR_ENDPN_INTEP_PREAMBLE : 0),
+               RP23XX_USBCTRL_REGS_ADDR_ENDPN(intnum));
+      setbits_reg32(1u << intnum, RP23XX_USBCTRL_REGS_INT_EP_CTRL);
+    }
+  else
+    {
+      privep->dpram = RP23XX_USBHOST_EPX_DATA;
+    }
+
+  *ep = (usbhost_ep_t)privep;
+  nxmutex_unlock(&priv->lock);
+  return OK;
+}
+
+static int rp23xx_usbhost_epfree(FAR struct usbhost_driver_s *drvr,
+                                 usbhost_ep_t ep)
+{
+  FAR struct rp23xx_usbhost_s *priv =
+    (FAR struct rp23xx_usbhost_s *)drvr;
+  FAR struct rp23xx_usbhost_ep_s *privep = rp23xx_usbhost_ep(ep);
+  int ret;
+
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (privep != NULL && privep != &priv->ep[0])
+    {
+      if (privep->interrupt && privep->intnum > 0)
+        {
+          clrbits_reg32(1u << privep->intnum,
+                        RP23XX_USBCTRL_REGS_INT_EP_CTRL);
+          putreg32(0, RP23XX_USBHOST_INT_EP_CTRL(privep->intnum));
+          putreg32(0, RP23XX_USBHOST_INT_BUF_CTRL(privep->intnum));
+          putreg32(0, RP23XX_USBCTRL_REGS_ADDR_ENDPN(privep->intnum));
+        }
+
+      privep->allocated = false;
+      privep->state = RP23XX_USBHOST_EP_IDLE;
+    }
+
+  nxmutex_unlock(&priv->lock);
+  return OK;
+}
