+static bool rp23xx_usbhost_need_preamble(
+  FAR const struct usbhost_hubport_s *hport)
+{
+#ifdef CONFIG_USBHOST_HUB
+  if (hport->parent != NULL && hport->speed == USB_SPEED_LOW &&
+      hport->parent->speed == USB_SPEED_FULL)
+    {
+      return true;
+    }
+#endif
+
+  return false;
+}
