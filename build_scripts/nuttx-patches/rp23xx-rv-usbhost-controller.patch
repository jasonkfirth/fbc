+
+static int rp23xx_usbhost_ctrlin(FAR struct usbhost_driver_s *drvr,
+                                 usbhost_ep_t ep0,
+                                 FAR const struct usb_ctrlreq_s *req,
+                                 FAR uint8_t *buffer)
+{
+  FAR struct rp23xx_usbhost_ep_s *ep = rp23xx_usbhost_ep(ep0);
+  uint16_t len = rp23xx_usbhost_reqlen(req);
+  int ret;
+
+  ret = rp23xx_usbhost_start_setup(ep, req);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (len > 0)
+    {
+      ep->in = true;
+      ep->nextpid = 1;
+      ret = rp23xx_usbhost_start_transfer(ep, buffer, len, false,
+                                          NULL, NULL);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+
+  ep->in = false;
+  ep->nextpid = 1;
+  ret = rp23xx_usbhost_start_transfer(ep, NULL, 0, false, NULL, NULL);
+  return ret < 0 ? ret : OK;
+}
+
+static int rp23xx_usbhost_ctrlout(FAR struct usbhost_driver_s *drvr,
+                                  usbhost_ep_t ep0,
+                                  FAR const struct usb_ctrlreq_s *req,
+                                  FAR const uint8_t *buffer)
+{
+  FAR struct rp23xx_usbhost_ep_s *ep = rp23xx_usbhost_ep(ep0);
+  uint16_t len = rp23xx_usbhost_reqlen(req);
+  int ret;
+
+  ret = rp23xx_usbhost_start_setup(ep, req);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (len > 0)
+    {
+      ep->in = false;
+      ep->nextpid = 1;
+      ret = rp23xx_usbhost_start_transfer(ep, (FAR uint8_t *)buffer,
+                                          len, false, NULL, NULL);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+
+  ep->in = true;
+  ep->nextpid = 1;
+  ret = rp23xx_usbhost_start_transfer(ep, NULL, 0, false, NULL, NULL);
+  return ret < 0 ? ret : OK;
+}
+
+static ssize_t rp23xx_usbhost_transfer(FAR struct usbhost_driver_s *drvr,
+                                       usbhost_ep_t ep,
+                                       FAR uint8_t *buffer, size_t buflen)
+{
+  FAR struct rp23xx_usbhost_ep_s *privep = rp23xx_usbhost_ep(ep);
+  int ret;
+
+  DEBUGASSERT(privep != NULL);
+  ret = rp23xx_usbhost_start_transfer(privep, buffer, buflen, false,
+                                      NULL, NULL);
+  return ret;
+}
+
+#ifdef CONFIG_USBHOST_ASYNCH
+static int rp23xx_usbhost_asynch(FAR struct usbhost_driver_s *drvr,
+                                 usbhost_ep_t ep, FAR uint8_t *buffer,
+                                 size_t buflen, usbhost_asynch_t callback,
+                                 FAR void *arg)
+{
+  FAR struct rp23xx_usbhost_ep_s *privep = rp23xx_usbhost_ep(ep);
+
+  DEBUGASSERT(privep != NULL && callback != NULL);
+  return rp23xx_usbhost_start_transfer(privep, buffer, buflen, true,
+                                       callback, arg);
+}
+#endif
+
+static int rp23xx_usbhost_cancel(FAR struct usbhost_driver_s *drvr,
+                                 usbhost_ep_t ep)
+{
+  FAR struct rp23xx_usbhost_ep_s *privep = rp23xx_usbhost_ep(ep);
+  irqstate_t flags;
+
+  if (privep == NULL)
+    {
+      return -EINVAL;
+    }
+
+  flags = enter_critical_section();
+  if (privep->state == RP23XX_USBHOST_EP_ACTIVE)
+    {
+      privep->cancelled = true;
+      if (!privep->interrupt)
+        {
+          rp23xx_usbhost_sie_stop();
+        }
+
+      rp23xx_usbhost_complete(privep, -ESHUTDOWN);
+    }
+  leave_critical_section(flags);
+  return OK;
+}
+
+#ifdef CONFIG_USBHOST_HUB
+static int rp23xx_usbhost_connect(FAR struct usbhost_driver_s *drvr,
+                                  FAR struct usbhost_hubport_s *hport,
+                                  bool connected)
+{
+  FAR struct rp23xx_usbhost_s *priv =
+    (FAR struct rp23xx_usbhost_s *)drvr;
+  int ret;
+
+  DEBUGASSERT(priv != NULL && hport != NULL);
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  hport->connected = connected;
+  priv->hport = hport;
+  nxsem_post(&priv->pscsem);
+  nxmutex_unlock(&priv->lock);
+  return OK;
+}
+#endif
+
+static void rp23xx_usbhost_disconnect(FAR struct usbhost_driver_s *drvr,
+                                      FAR struct usbhost_hubport_s *hport)
+{
+  DEBUGASSERT(hport != NULL);
+  hport->devclass = NULL;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+FAR struct usbhost_connection_s *rp23xx_usbhost_initialize(void)
+{
+  FAR struct rp23xx_usbhost_s *priv = &g_usbhost;
+  FAR struct usbhost_hubport_s *hport;
+  int i;
+
+  if (priv->initialized)
+    {
+      return &priv->conn;
+    }
+
+  memset(priv, 0, sizeof(*priv));
+
+  priv->drvr.ep0configure = rp23xx_usbhost_ep0configure;
+  priv->drvr.epalloc      = rp23xx_usbhost_epalloc;
+  priv->drvr.epfree       = rp23xx_usbhost_epfree;
+  priv->drvr.alloc        = rp23xx_usbhost_alloc;
+  priv->drvr.free         = rp23xx_usbhost_free;
+  priv->drvr.ioalloc      = rp23xx_usbhost_ioalloc;
+  priv->drvr.iofree       = rp23xx_usbhost_iofree;
+  priv->drvr.ctrlin       = rp23xx_usbhost_ctrlin;
+  priv->drvr.ctrlout      = rp23xx_usbhost_ctrlout;
+  priv->drvr.transfer     = rp23xx_usbhost_transfer;
+#ifdef CONFIG_USBHOST_ASYNCH
+  priv->drvr.asynch       = rp23xx_usbhost_asynch;
+#endif
+  priv->drvr.cancel       = rp23xx_usbhost_cancel;
+#ifdef CONFIG_USBHOST_HUB
+  priv->drvr.connect      = rp23xx_usbhost_connect;
+#endif
+  priv->drvr.disconnect   = rp23xx_usbhost_disconnect;
+
+  priv->conn.wait         = rp23xx_usbhost_wait;
+  priv->conn.enumerate    = rp23xx_usbhost_enumerate;
+
+  hport = &priv->rhport.hport;
+  hport->drvr             = &priv->drvr;
+#ifdef CONFIG_USBHOST_HUB
+  hport->parent           = NULL;
+#endif
+  hport->ep0              = (usbhost_ep_t)&priv->ep[0];
+  hport->speed            = USB_SPEED_UNKNOWN;
+  hport->port             = 0;
+  hport->funcaddr         = 0;
+
+  usbhost_devaddr_initialize(&priv->devgen);
+  priv->rhport.pdevgen = &priv->devgen;
+
+  nxmutex_init(&priv->lock);
+  spin_lock_init(&priv->irqlock);
+  nxsem_init(&priv->pscsem, 0, 0);
+
+  for (i = 0; i < RP23XX_USBHOST_MAX_ENDPOINTS; i++)
+    {
+      priv->ep[i].priv = priv;
+      nxsem_init(&priv->ep[i].waitsem, 0, 0);
+    }
+
+  priv->ep[0].allocated = true;
+  priv->ep[0].epno = 0;
+  priv->ep[0].funcaddr = 0;
+  priv->ep[0].speed = USB_SPEED_FULL;
+  priv->ep[0].xfrtype = USB_EP_ATTR_XFER_CONTROL;
+  priv->ep[0].maxpacket = RP23XX_USBHOST_MAX_PACKET;
+  priv->ep[0].dpram = RP23XX_USBHOST_EPX_DATA;
+
+  rp23xx_usbhost_hw_initialize(priv);
+  priv->initialized = true;
+  return &priv->conn;
+}
+
