+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct rp23xx_usbhost_s g_usbhost;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline FAR struct rp23xx_usbhost_ep_s *
+rp23xx_usbhost_ep(usbhost_ep_t ep)
+{
+  return (FAR struct rp23xx_usbhost_ep_s *)ep;
+}
+
+static uint16_t rp23xx_usbhost_reqlen(FAR const struct usb_ctrlreq_s *req)
+{
+  return (uint16_t)GETUINT16(req->len);
+}
+
+static uint32_t rp23xx_usbhost_epctrl_type(uint8_t xfrtype)
+{
+  switch (xfrtype)
+    {
+      case USB_EP_ATTR_XFER_CONTROL:
+        return RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_TYPE_CTRL;
+
+      case USB_EP_ATTR_XFER_ISOC:
+        return RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_TYPE_ISO;
+
+      case USB_EP_ATTR_XFER_BULK:
+        return RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_TYPE_BULK;
+
+      case USB_EP_ATTR_XFER_INT:
+      default:
+        return RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_TYPE_INTR;
+    }
+}
+
+static uint32_t rp23xx_usbhost_buffstat_bit(
+  FAR const struct rp23xx_usbhost_ep_s *ep)
+{
+  if (!ep->interrupt)
+    {
+      return RP23XX_USBHOST_EPX_BUFF_STATUS;
+    }
+
+  return 1u << (ep->intnum * 2 + (ep->in ? 0 : 1));
+}
+
+static uint32_t rp23xx_usbhost_buf_ctrl(
+  FAR const struct rp23xx_usbhost_ep_s *ep)
+{
+  return ep->interrupt ? RP23XX_USBHOST_INT_BUF_CTRL(ep->intnum) :
+                         RP23XX_USBHOST_EPX_BUF_CTRL;
+}
+
+static uint32_t rp23xx_usbhost_ep_ctrl(
+  FAR const struct rp23xx_usbhost_ep_s *ep)
+{
+  return ep->interrupt ? RP23XX_USBHOST_INT_EP_CTRL(ep->intnum) :
+                         RP23XX_USBHOST_EPX_CTRL;
+}
+
+static void rp23xx_usbhost_dpram_copyout(uintptr_t dest,
+                                         FAR const uint8_t *src,
+                                         size_t len)
+{
+  FAR volatile uint8_t *pdest = (FAR volatile uint8_t *)dest;
+  size_t i;
+
+  for (i = 0; i < len; i++)
+    {
+      pdest[i] = src[i];
+    }
+}
+
+static void rp23xx_usbhost_dpram_copyin(FAR uint8_t *dest,
+                                        uintptr_t src, size_t len)
+{
+  FAR volatile uint8_t *psrc = (FAR volatile uint8_t *)src;
+  size_t i;
+
+  for (i = 0; i < len; i++)
+    {
+      dest[i] = psrc[i];
+    }
+}
+
+static void rp23xx_usbhost_sie_start(bool setup, bool in,
+                                     bool need_preamble)
+{
+  uint32_t siectrl = getreg32(RP23XX_USBCTRL_REGS_SIE_CTRL) &
+                     RP23XX_USBHOST_SIE_BASE_MASK;
+  volatile int delay;
+
+  if (setup)
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_SEND_SETUP;
+    }
+  else if (in)
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_RECEIVE_DATA;
+    }
+  else
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_SEND_DATA;
+    }
+
+  if (need_preamble)
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_PREAMBLE_EN;
+    }
+
+  putreg32(siectrl, RP23XX_USBCTRL_REGS_SIE_CTRL);
+
+  /*
+   * The RP USB controller treats START_TRANS like the DPRAM buffer
+   * AVAILABLE bit.  Keep a short write separation so the controller sees
+   * the transaction direction and setup bit before START_TRANS rises.
+   */
+
+  for (delay = 0; delay < 12; delay++)
+    ;
+
+  putreg32(siectrl | RP23XX_USBCTRL_REGS_SIE_CTRL_START_TRANS,
+           RP23XX_USBCTRL_REGS_SIE_CTRL);
+}
+
+static void rp23xx_usbhost_sie_stop(void)
+{
+  uint32_t siectrl = getreg32(RP23XX_USBCTRL_REGS_SIE_CTRL) &
+                     RP23XX_USBHOST_SIE_BASE_MASK;
+
+  putreg32(siectrl | RP23XX_USBCTRL_REGS_SIE_CTRL_STOP_TRANS,
+           RP23XX_USBCTRL_REGS_SIE_CTRL);
+  while ((getreg32(RP23XX_USBCTRL_REGS_SIE_CTRL) &
+          RP23XX_USBCTRL_REGS_SIE_CTRL_STOP_TRANS) != 0)
+    ;
+}
+
+static void rp23xx_usbhost_configure_frames(uint8_t speed)
+{
+  uint32_t siectrl = getreg32(RP23XX_USBCTRL_REGS_SIE_CTRL) &
+                     RP23XX_USBHOST_SIE_BASE;
+
+  if (speed == USB_SPEED_LOW)
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_KEEP_ALIVE_EN;
+    }
+  else
+    {
+      siectrl |= RP23XX_USBCTRL_REGS_SIE_CTRL_SOF_EN;
+    }
+
+  putreg32(siectrl, RP23XX_USBCTRL_REGS_SIE_CTRL);
+}
+
+static uint8_t rp23xx_usbhost_hw_speed(void)
+{
+  uint32_t speed = RP23XX_USBHOST_SPEED(
+    getreg32(RP23XX_USBCTRL_REGS_SIE_STATUS));
+
+  if (speed == RP23XX_USBHOST_SPEED_LOW)
+    {
+      return USB_SPEED_LOW;
+    }
+
+  if (speed == RP23XX_USBHOST_SPEED_FULL)
+    {
+      return USB_SPEED_FULL;
+    }
+
+  return USB_SPEED_UNKNOWN;
+}
+
+static void rp23xx_usbhost_complete(FAR struct rp23xx_usbhost_ep_s *ep,
+                                    ssize_t result)
+{
+  usbhost_asynch_t callback;
+  FAR void *arg;
+
+  ep->result = result;
+  ep->state = RP23XX_USBHOST_EP_DONE;
+
+  if (!ep->interrupt)
+    {
+      ep->priv->epx = NULL;
+    }
+
+  callback = ep->callback;
+  arg = ep->arg;
+  ep->callback = NULL;
+  ep->arg = NULL;
+
+  if (callback)
+    {
+      callback(arg, result);
+    }
+  else
+    {
+      nxsem_post(&ep->waitsem);
+    }
+}
+
+static void rp23xx_usbhost_disconnected(
+  FAR struct rp23xx_usbhost_s *priv)
+{
+  int i;
+
+  if (priv->rhport.hport.devclass != NULL)
+    {
+      CLASS_DISCONNECTED(priv->rhport.hport.devclass);
+      priv->rhport.hport.devclass = NULL;
+    }
+
+  priv->connected = false;
+  priv->change = true;
+  priv->rhport.hport.connected = false;
+  priv->rhport.hport.speed = USB_SPEED_UNKNOWN;
+
+  for (i = 0; i < RP23XX_USBHOST_MAX_ENDPOINTS; i++)
+    {
+      FAR struct rp23xx_usbhost_ep_s *ep = &priv->ep[i];
+
+      if (ep->state == RP23XX_USBHOST_EP_ACTIVE)
+        {
+          ep->cancelled = true;
+          rp23xx_usbhost_complete(ep, -ESHUTDOWN);
+        }
+    }
+
+  priv->epx = NULL;
+  nxsem_post(&priv->pscsem);
+}
+
+static void rp23xx_usbhost_connected(FAR struct rp23xx_usbhost_s *priv)
+{
+  uint8_t speed = rp23xx_usbhost_hw_speed();
+
+  if (speed == USB_SPEED_UNKNOWN)
+    {
+      return;
+    }
+
+  priv->connected = true;
+  priv->change = true;
+  priv->rhport.hport.speed = speed;
+  rp23xx_usbhost_configure_frames(speed);
+  nxsem_post(&priv->pscsem);
+}
+
+static void rp23xx_usbhost_start_packet(
+  FAR struct rp23xx_usbhost_ep_s *ep)
+{
+  size_t packet;
+  uint32_t ctrl;
+  uint32_t epctrl;
+  uint32_t bufctrl;
+
+  if (ep->zlp)
+    {
+      packet = 0;
+    }
+  else
+    {
+      packet = ep->remaining;
+      if (packet > ep->maxpacket)
+        {
+          packet = ep->maxpacket;
+        }
+      if (packet > RP23XX_USBHOST_MAX_PACKET)
+        {
+          packet = RP23XX_USBHOST_MAX_PACKET;
+        }
+    }
+
+  if (!ep->in && packet > 0)
+    {
+      rp23xx_usbhost_dpram_copyout(ep->dpram,
+                                   ep->buffer + ep->xferred,
+                                   packet);
+    }
+
+  bufctrl = (uint32_t)packet;
+  bufctrl |= RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_AVAIL;
+  bufctrl |= RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_SEL;
+
+  if (!ep->in)
+    {
+      bufctrl |= RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_FULL;
+    }
+
+  if (ep->nextpid != 0)
+    {
+      bufctrl |= RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_DATA1_PID;
+    }
+
+  if (packet == ep->remaining)
+    {
+      bufctrl |= RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_LAST;
+    }
+
+  if (!ep->zlp)
+    {
+      ep->remaining -= packet;
+    }
+
+  ep->nextpid ^= 1;
+  ep->state = RP23XX_USBHOST_EP_ACTIVE;
+
+  epctrl = RP23XX_USBCTRL_DPSRAM_EP_CTRL_ENABLE |
+           RP23XX_USBCTRL_DPSRAM_EP_CTRL_INT_1BUF |
+           rp23xx_usbhost_epctrl_type(ep->xfrtype) |
+           ((uint32_t)(ep->dpram - RP23XX_USBCTRL_DPSRAM_BASE) &
+            RP23XX_USBCTRL_DPSRAM_EP_CTRL_EP_ADDR_MASK);
+
+  if (!ep->interrupt)
+    {
+      putreg32(epctrl, rp23xx_usbhost_ep_ctrl(ep));
+      putreg32(bufctrl, rp23xx_usbhost_buf_ctrl(ep));
+      putreg32((uint32_t)ep->funcaddr |
+               ((uint32_t)ep->epno <<
+                RP23XX_USBCTRL_REGS_ADDR_ENDP_ENDPOINT_SHIFT),
+               RP23XX_USBCTRL_REGS_ADDR_ENDP);
+
+      ctrl = RP23XX_USBHOST_NAK_POLL |
+             RP23XX_USBCTRL_REGS_NAK_POLL_STOP_EPX_ON_NAK;
+      putreg32(ctrl, RP23XX_USBCTRL_REGS_NAK_POLL);
+
+      rp23xx_usbhost_sie_start(false, ep->in, ep->need_preamble);
+    }
+  else
+    {
+      putreg32(bufctrl, rp23xx_usbhost_buf_ctrl(ep));
+    }
+}
+
+static int rp23xx_usbhost_start_transfer(
+  FAR struct rp23xx_usbhost_ep_s *ep, FAR uint8_t *buffer, size_t buflen,
+  bool async, usbhost_asynch_t callback, FAR void *arg)
+{
+  FAR struct rp23xx_usbhost_s *priv = ep->priv;
+  irqstate_t flags;
+  int ret;
+
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (!priv->connected)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -ENODEV;
+    }
+
+  if (ep->state == RP23XX_USBHOST_EP_ACTIVE)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -EBUSY;
+    }
+
+  if (!ep->interrupt && priv->epx != NULL)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -EBUSY;
+    }
+
+  ep->setup = false;
+  ep->zlp = (buflen == 0);
+  ep->cancelled = false;
+  ep->buffer = buffer;
+  ep->buflen = buflen;
+  ep->remaining = buflen;
+  ep->xferred = 0;
+  ep->result = -EBUSY;
+  ep->callback = async ? callback : NULL;
+  ep->arg = async ? arg : NULL;
+
+  flags = enter_critical_section();
+  if (!ep->interrupt)
+    {
+      priv->epx = ep;
+    }
+
+  rp23xx_usbhost_start_packet(ep);
+  leave_critical_section(flags);
+  nxmutex_unlock(&priv->lock);
+
+  if (async)
+    {
+      return OK;
+    }
+
+  ret = nxsem_wait_uninterruptible(&ep->waitsem);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  return ep->result;
+}
+
+static int rp23xx_usbhost_start_setup(
+  FAR struct rp23xx_usbhost_ep_s *ep,
+  FAR const struct usb_ctrlreq_s *req)
+{
+  FAR struct rp23xx_usbhost_s *priv = ep->priv;
+  FAR volatile uint8_t *setup =
+    (FAR volatile uint8_t *)RP23XX_USBCTRL_DPSRAM_SETUP_PACKET;
+  FAR const uint8_t *src = (FAR const uint8_t *)req;
+  irqstate_t flags;
+  int ret;
+  int i;
+
+  ret = nxmutex_lock(&priv->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (!priv->connected)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -ENODEV;
+    }
+
+  if (priv->epx != NULL)
+    {
+      nxmutex_unlock(&priv->lock);
+      return -EBUSY;
+    }
+
+  for (i = 0; i < USB_SIZEOF_CTRLREQ; i++)
+    {
+      setup[i] = src[i];
+    }
+
+  ep->setup = true;
+  ep->zlp = false;
+  ep->cancelled = false;
+  ep->in = false;
+  ep->buffer = NULL;
+  ep->buflen = USB_SIZEOF_CTRLREQ;
+  ep->remaining = USB_SIZEOF_CTRLREQ;
+  ep->xferred = 0;
+  ep->result = -EBUSY;
+  ep->callback = NULL;
+  ep->arg = NULL;
+  ep->state = RP23XX_USBHOST_EP_ACTIVE;
+  priv->epx = ep;
+
+  flags = enter_critical_section();
+  putreg32((uint32_t)ep->funcaddr, RP23XX_USBCTRL_REGS_ADDR_ENDP);
+  rp23xx_usbhost_sie_start(true, false, ep->need_preamble);
+  leave_critical_section(flags);
+
+  nxmutex_unlock(&priv->lock);
+
+  ret = nxsem_wait_uninterruptible(&ep->waitsem);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  return ep->result;
+}
+
+static void rp23xx_usbhost_handle_done(
+  FAR struct rp23xx_usbhost_ep_s *ep)
+{
+  uint32_t bufreg = rp23xx_usbhost_buf_ctrl(ep);
+  uint32_t bufctrl32 = getreg32(bufreg);
+  uint16_t bufctrl;
+  size_t nbytes;
+  bool shortpacket;
+
+  /*
+   * EPX is single-buffered in this first driver.  RP2350 reports which half
+   * the CPU should handle, but older RP2040 silicon sometimes reports the
+   * upper half for host single-buffer transfers.  Prefer whichever half has
+   * completion state.
+   */
+
+  bufctrl = (uint16_t)bufctrl32;
+  if (bufctrl == 0 && (bufctrl32 >> 16) != 0)
+    {
+      bufctrl = (uint16_t)(bufctrl32 >> 16);
+    }
+
+  nbytes = bufctrl & RP23XX_USBCTRL_DPSRAM_EP_BUFF_CTRL_LEN_MASK;
+
+  if (ep->in && nbytes > 0 && ep->buffer != NULL)
+    {
+      rp23xx_usbhost_dpram_copyin(ep->buffer + ep->xferred,
+                                  ep->dpram, nbytes);
+    }
+
+  ep->xferred += nbytes;
+  shortpacket = nbytes < ep->maxpacket;
+
+  putreg32(rp23xx_usbhost_buffstat_bit(ep),
+           RP23XX_USBCTRL_REGS_BUFF_STATUS);
+  putreg32(0, bufreg);
+
+  if (ep->cancelled)
+    {
+      rp23xx_usbhost_complete(ep, -ESHUTDOWN);
+      return;
+    }
+
+  if (ep->zlp || shortpacket || ep->remaining == 0)
+    {
+      rp23xx_usbhost_complete(ep, ep->xferred);
+    }
+  else
+    {
+      rp23xx_usbhost_start_packet(ep);
+    }
+}
+
+static int rp23xx_usbhost_interrupt(int irq, FAR void *context,
+                                    FAR void *arg)
+{
+  FAR struct rp23xx_usbhost_s *priv = (FAR struct rp23xx_usbhost_s *)arg;
+  irqstate_t flags;
+  uint32_t ints;
+  uint32_t status;
+  int i;
+
+  flags = spin_lock_irqsave(&priv->irqlock);
+  ints = getreg32(RP23XX_USBCTRL_REGS_INTS);
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_HOST_CONN_DIS) != 0)
+    {
+      status = getreg32(RP23XX_USBCTRL_REGS_SIE_STATUS);
+      putreg32(RP23XX_USBCTRL_REGS_SIE_STATUS_SPEED_MASK,
+               RP23XX_USBCTRL_REGS_SIE_STATUS);
+
+      if (RP23XX_USBHOST_SPEED(status) == RP23XX_USBHOST_SPEED_DISCONNECT)
+        {
+          rp23xx_usbhost_disconnected(priv);
+        }
+      else
+        {
+          rp23xx_usbhost_connected(priv);
+        }
+    }
+
+  if ((ints & RP23XX_USBHOST_ERROR_INTS) != 0)
+    {
+      status = getreg32(RP23XX_USBCTRL_REGS_SIE_STATUS);
+      putreg32(status & (RP23XX_USBCTRL_REGS_SIE_STATUS_STALL_REC |
+                         RP23XX_USBCTRL_REGS_SIE_STATUS_RX_TIMEOUT |
+                         RP23XX_USBCTRL_REGS_SIE_STATUS_DATA_SEQ_ERROR),
+               RP23XX_USBCTRL_REGS_SIE_STATUS);
+
+      if (priv->epx != NULL)
+        {
+          if ((ints & RP23XX_USBCTRL_REGS_INTR_STALL) != 0)
+            {
+              rp23xx_usbhost_complete(priv->epx, -EPIPE);
+            }
+          else
+            {
+              rp23xx_usbhost_complete(priv->epx, -EIO);
+            }
+        }
+    }
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_TRANS_COMPLETE) != 0)
+    {
+      putreg32(RP23XX_USBCTRL_REGS_SIE_STATUS_TRANS_COMPLETE,
+               RP23XX_USBCTRL_REGS_SIE_STATUS);
+
+      if (priv->epx != NULL && priv->epx->setup)
+        {
+          priv->epx->setup = false;
+          priv->epx->xferred = USB_SIZEOF_CTRLREQ;
+          rp23xx_usbhost_complete(priv->epx, OK);
+        }
+    }
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_BUFF_STATUS) != 0)
+    {
+      uint32_t buff = getreg32(RP23XX_USBCTRL_REGS_BUFF_STATUS);
+
+      if ((buff & RP23XX_USBHOST_EPX_BUFF_STATUS) != 0 &&
+          priv->epx != NULL && !priv->epx->setup)
+        {
+          rp23xx_usbhost_handle_done(priv->epx);
+        }
+
+      for (i = 1; i < RP23XX_USBHOST_MAX_ENDPOINTS; i++)
+        {
+          FAR struct rp23xx_usbhost_ep_s *ep = &priv->ep[i];
+
+          if (ep->allocated && ep->interrupt &&
+              ep->state == RP23XX_USBHOST_EP_ACTIVE &&
+              (buff & rp23xx_usbhost_buffstat_bit(ep)) != 0)
+            {
+              rp23xx_usbhost_handle_done(ep);
+            }
+        }
+    }
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_HOST_RESUME) != 0)
+    {
+      putreg32(RP23XX_USBCTRL_REGS_SIE_STATUS_RESUME,
+               RP23XX_USBCTRL_REGS_SIE_STATUS);
+    }
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_EP_STALL_NAK) != 0)
+    {
+      putreg32(getreg32(RP23XX_USBCTRL_REGS_EP_STATUS_STALL_NAK),
+               RP23XX_USBCTRL_REGS_EP_STATUS_STALL_NAK);
+    }
+
+  if ((ints & RP23XX_USBCTRL_REGS_INTR_HOST_SOF) != 0)
+    {
+      (void)getreg32(RP23XX_USBCTRL_REGS_SOF_RD);
+    }
+
+  spin_unlock_irqrestore(&priv->irqlock, flags);
+  return OK;
+}
+
+static void rp23xx_usbhost_hw_initialize(
+  FAR struct rp23xx_usbhost_s *priv)
+{
+  setbits_reg32(RP23XX_RESETS_RESET_USBCTRL, RP23XX_RESETS_RESET);
+  clrbits_reg32(RP23XX_RESETS_RESET_USBCTRL, RP23XX_RESETS_RESET);
+  while ((getreg32(RP23XX_RESETS_RESET_DONE) &
+          RP23XX_RESETS_RESET_USBCTRL) == 0)
+    ;
+
+  memset((FAR void *)RP23XX_USBCTRL_DPSRAM_BASE, 0,
+         RP23XX_USBHOST_DPRAM_SIZE);
+
+  putreg32(0, RP23XX_USBCTRL_REGS_INTE);
+  putreg32(0xffffffff, RP23XX_USBCTRL_REGS_SIE_STATUS);
+  putreg32(0, RP23XX_USBCTRL_REGS_BUFF_STATUS);
+  putreg32(0, RP23XX_USBCTRL_REGS_INT_EP_CTRL);
+  putreg32(0, RP23XX_USBCTRL_REGS_NAK_POLL);
+
+  setbits_reg32(RP23XX_USBCTRL_REGS_USB_MUXING_SOFTCON |
+                RP23XX_USBCTRL_REGS_USB_MUXING_TO_PHY,
+                RP23XX_USBCTRL_REGS_USB_MUXING);
+
+  setbits_reg32(RP23XX_USBCTRL_REGS_USB_PWR_VBUS_DETECT |
+                RP23XX_USBCTRL_REGS_USB_PWR_VBUS_DETECT_OVERRIDE_EN,
+                RP23XX_USBCTRL_REGS_USB_PWR);
+
+  putreg32(RP23XX_USBCTRL_REGS_MAIN_CTRL_CONTROLLER_EN |
+           RP23XX_USBCTRL_REGS_MAIN_CTRL_HOST_NDEVICE,
+           RP23XX_USBCTRL_REGS_MAIN_CTRL);
+  putreg32(RP23XX_USBHOST_SIE_BASE, RP23XX_USBCTRL_REGS_SIE_CTRL);
+
+  setbits_reg32(RP23XX_USBCTRL_REGS_LINESTATE_TUNING_MULTI_HUB_FIX |
+                RP23XX_USBCTRL_REGS_LINESTATE_TUNING_LINESTATE_DELAY,
+                RP23XX_USBCTRL_REGS_LINESTATE_TUNING);
+
+  putreg32(RP23XX_USBHOST_INIT_INTS |
+           RP23XX_USBCTRL_REGS_INTR_EP_STALL_NAK,
+           RP23XX_USBCTRL_REGS_INTE);
+
+  irq_attach(RP23XX_USBCTRL_IRQ, rp23xx_usbhost_interrupt, priv);
+  up_enable_irq(RP23XX_USBCTRL_IRQ);
+}
+
+static int rp23xx_usbhost_root_reset(
+  FAR struct rp23xx_usbhost_s *priv)
+{
+  uint8_t speed;
+
+  if (!priv->connected)
+    {
+      return -ENODEV;
+    }
+
+  nxsched_usleep(100 * 1000);
+
+  if (!priv->connected)
+    {
+      return -ENODEV;
+    }
+
+  clrbits_reg32(RP23XX_USBCTRL_REGS_SIE_CTRL_SOF_EN |
+                RP23XX_USBCTRL_REGS_SIE_CTRL_KEEP_ALIVE_EN,
+                RP23XX_USBCTRL_REGS_SIE_CTRL);
+  setbits_reg32(RP23XX_USBCTRL_REGS_SIE_CTRL_RESET_BUS,
+                RP23XX_USBCTRL_REGS_SIE_CTRL);
+  nxsched_usleep(50 * 1000);
+  clrbits_reg32(RP23XX_USBCTRL_REGS_SIE_CTRL_RESET_BUS,
+                RP23XX_USBCTRL_REGS_SIE_CTRL);
+  nxsched_usleep(10 * 1000);
+
+  speed = rp23xx_usbhost_hw_speed();
+  if (speed == USB_SPEED_UNKNOWN)
+    {
+      return -ENODEV;
+    }
+
+  priv->rhport.hport.speed = speed;
+  rp23xx_usbhost_configure_frames(speed);
+  return OK;
+}
+
+static int rp23xx_usbhost_wait(FAR struct usbhost_connection_s *conn,
+                               FAR struct usbhost_hubport_s **hport)
+{
+  FAR struct rp23xx_usbhost_s *priv =
+    (FAR struct rp23xx_usbhost_s *)conn;
+  int ret;
+
+  for (; ; )
+    {
+      ret = nxmutex_lock(&priv->lock);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if (priv->change)
+        {
+          priv->change = false;
+          priv->rhport.hport.connected = priv->connected;
+          *hport = &priv->rhport.hport;
+          nxmutex_unlock(&priv->lock);
+          return OK;
+        }
+
+#ifdef CONFIG_USBHOST_HUB
+      if (priv->hport != NULL)
+        {
+          *hport = priv->hport;
+          priv->hport = NULL;
+          nxmutex_unlock(&priv->lock);
+          return OK;
+        }
+#endif
+
+      nxmutex_unlock(&priv->lock);
+      ret = nxsem_wait_uninterruptible(&priv->pscsem);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+}
+
+static int rp23xx_usbhost_enumerate(FAR struct usbhost_connection_s *conn,
+                                    FAR struct usbhost_hubport_s *hport)
+{
+  FAR struct rp23xx_usbhost_s *priv =
+    (FAR struct rp23xx_usbhost_s *)conn;
+  int ret;
+
+#ifdef CONFIG_USBHOST_HUB
+  if (hport->parent == NULL)
+#endif
+    {
+      ret = rp23xx_usbhost_root_reset(priv);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+
+  ret = usbhost_enumerate(hport, &hport->devclass);
+  if (ret < 0)
+    {
+      uerr("ERROR: usbhost_enumerate failed: %d\n", ret);
+    }
+
+  return ret;
+}
