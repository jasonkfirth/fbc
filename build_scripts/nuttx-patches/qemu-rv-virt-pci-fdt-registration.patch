+#if defined(CONFIG_LIBC_FDT) && defined(CONFIG_DEVICE_TREE) && \
+    defined(CONFIG_PCI)
+
+/****************************************************************************
+ * Name: qemu_pci_register_from_fdt
+ ****************************************************************************/
+
+static void qemu_pci_register_from_fdt(void)
+{
+  const void *fdt = fdt_get();
+  int ret;
+
+  if (fdt == NULL)
+    {
+      return;
+    }
+
+  ret = fdt_pci_ecam_register(fdt);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "fdt_pci_ecam_register failed, ret=%d\n", ret);
+    }
+}
+
+#else
+#  define qemu_pci_register_from_fdt()
+#endif
+
 /****************************************************************************
