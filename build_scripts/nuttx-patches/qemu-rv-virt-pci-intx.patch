+/****************************************************************************
+ * Name: up_get_legacy_irq
+ *
+ * Description:
+ *   Return the NuttX IRQ number for a QEMU virt PCI INTx pin.
+ *
+ *   QEMU's riscv virt machine describes the PCI host bridge in the generated
+ *   device tree.  Its interrupt-map routes INT[A-D] over PLIC interrupt IDs
+ *   32 through 35, rotating the pin assignment by slot number in the usual
+ *   PCI fashion.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_PCI
+int up_get_legacy_irq(uint32_t devfn, uint8_t line, uint8_t pin)
+{
+  uint8_t slot;
+  uint8_t index;
+
+  UNUSED(line);
+
+  if (pin < PCI_INTERRUPT_INTA || pin > PCI_INTERRUPT_INTD)
+    {
+      return -EINVAL;
+    }
+
+  slot = PCI_SLOT(devfn);
+  index = (pin - PCI_INTERRUPT_INTA + slot) % QEMU_RV_PCI_INTX_COUNT;
+
+  return RISCV_IRQ_EXT + QEMU_RV_PCI_INTX_BASE + index;
+}
+#endif
